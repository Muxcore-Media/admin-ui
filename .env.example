# MuxCore Admin UI — Environment Variables
# Copy to .env and fill in values for your environment.
# All variables are optional — defaults shown in comments.

# === HTTP Server ===
# ADMIN_UI_ADDR=:8080
# ADMIN_UI_TLS_CERT=/etc/ssl/server-cert.pem
# ADMIN_UI_TLS_KEY=/etc/ssl/server-key.pem

# === Core Connection ===
# ADMIN_UI_CORE_ADDR=localhost:9090
# MUXCORE_INSECURE_DISABLE_TLS=false  # "true" only in the dev profile (plaintext mesh gRPC; loud warning)
# MUXCORE_TLS_CA=/etc/muxcore/ca.pem   # verify core/module gRPC servers (system roots when unset)
# MUXCORE_TLS_CERT=                    # optional mTLS client cert
# MUXCORE_TLS_KEY=

# === Auth module ===
# ADMIN_UI_AUTH_ADDR=http://localhost:9401
# ADMIN_UI_AUTH_INTERNAL_ADDR=http://127.0.0.1:9401
# ADMIN_UI_PUBLIC_URL=https://admin.example.com

# === Session ===
# ADMIN_UI_SESSION_TTL=30m
# ADMIN_UI_SESSION_KEY=      # key for session bearer encryption; default: generated <data dir>/session.key (0600)

# === Durable state (shared with media-ui BFF on vault) ===
# ADMIN_UI_DATA_DIR=/var/lib/muxcore/media-ui
# ADMIN_UI_BRANDING_FILE=
# ADMIN_UI_NETWORKING_FILE=
# ADMIN_UI_PARENTAL_FILE=
# ADMIN_UI_LIVETV_FILE=
# ADMIN_UI_PLAYBACK_FILE=
# ADMIN_UI_PASSWORD_RESET_FILE=
# ADMIN_UI_SESSION_FILE=
# ADMIN_UI_RESTORE_ROOT=/data/restore  # backup restore targets must be inside (falls back to BACKUP_RESTORE_DIR)

# === Integrations ===
# ADMIN_UI_HEALTH_MONITOR_URL=http://127.0.0.1:9203
# ADMIN_UI_USERDATA_URL=http://127.0.0.1:9672
# ADMIN_UI_REQUEST_MEDIA_URL=http://127.0.0.1:9410  # optional override; empty = mesh discovery via media.request capability
# ADMIN_UI_METRICS_TOKEN=

# === Logging ===
# ADMIN_UI_LOG_LEVEL=info    # debug | info | warn | error
# ADMIN_UI_LOG_FORMAT=text   # text | json

# === Reverse proxy ===
# ADMIN_UI_TRUSTED_PROXIES=  # empty = loopback only (127.0.0.0/8, ::1/128)
