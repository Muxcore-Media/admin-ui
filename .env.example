# MuxCore Admin UI — Environment Variables
# Copy to .env and fill in values for your environment.
# All variables are optional — defaults shown in comments.

# === HTTP Server ===
# ADMIN_UI_ADDR=:8080
# ADMIN_UI_TLS_CERT=/etc/ssl/server-cert.pem
# ADMIN_UI_TLS_KEY=/etc/ssl/server-key.pem

# === Core Connection ===
# ADMIN_UI_CORE_ADDR=localhost:9090
# ADMIN_UI_INSECURE=false    # Set "true" for local dev (disables TLS for gRPC)

# === Auth module ===
# ADMIN_UI_AUTH_ADDR=http://localhost:9401

# === Session ===
# ADMIN_UI_SESSION_TTL=30m

# === Logging ===
# ADMIN_UI_LOG_LEVEL=info    # debug | info | warn | error
# ADMIN_UI_LOG_FORMAT=text   # text | json

# === Reverse proxy ===
# ADMIN_UI_TRUSTED_PROXIES=  # empty = loopback only (127.0.0.0/8, ::1/128)
