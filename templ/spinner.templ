package templates

import "fmt"

templ Spinner(class string) {
	<svg class={ "animate-spin " + class } xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
		<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
		<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
	</svg>
}

templ LoadingRow(colspan int) {
	<tr>
		<td colspan={ fmt.Sprint(colspan) } class="px-3 py-8 text-center text-sm text-gray-500">
			<div class="flex items-center justify-center gap-2">
				@Spinner("w-4 h-4 text-gray-400")
				<span>Loading...</span>
			</div>
		</td>
	</tr>
}

templ LoadingCard() {
	<div class="rounded-xl border border-gray-800 bg-gray-900/50 p-4 col-span-full">
		<div class="flex items-center gap-2 text-gray-400">
			@Spinner("w-4 h-4 text-gray-400")
			<span class="text-sm">Loading...</span>
		</div>
	</div>
}
