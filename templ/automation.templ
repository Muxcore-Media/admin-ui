package templates

import "fmt"

type AutomationQueueItem struct {
	ID        string
	ItemID    string
	ItemType  string
	Title     string
	Year      int
	TMDBID    int
	Monitored bool
	Missing   bool
	UpdatedAt string
}

type AutomationHistoryItem struct {
	ID     string
	Status string
	Title  string
	Source string
	At     string
}

type AutomationPageData struct {
	Items       []AutomationQueueItem
	History     []AutomationHistoryItem
	Filter      string
	Page        int
	PageSize    int
	Total       int
	TotalPages  int
	Error       string
	Flash       string
	FlashStatus string
}

templ AutomationPage(data AutomationPageData) {
	<div
		class="space-y-6"
		data-testid="automation-page"
		hx-get="/automation"
		hx-trigger="every 15s"
		hx-select="[data-testid='automation-page']"
		hx-swap="outerHTML"
		hx-include="[name='filter']"
	>
		<div>
			<h1 class="text-2xl font-bold">Automation</h1>
			<p class="text-gray-400 text-sm mt-1">Wanted queue and recent download history from media-automation</p>
		</div>

		if data.Flash != "" {
			<div class="rounded-xl border border-green-900/50 bg-green-950/20 p-4 text-sm text-green-300" data-testid="dispatch-flash">
				Dispatched download_id={ data.Flash }
				if data.FlashStatus != "" {
					<span class="text-gray-400"> status={ data.FlashStatus }</span>
				}
			</div>
		}
		if data.Error != "" {
			<div class="rounded-xl border border-yellow-900/50 bg-yellow-950/20 p-4 text-sm text-yellow-300">{ data.Error }</div>
		}

		<form class="flex flex-wrap gap-3 items-end" method="get" action="/automation">
			<div>
				<label class="block text-xs font-medium text-gray-500 mb-1">Filter</label>
				<select name="filter" class="rounded-lg border border-gray-700 bg-gray-800 px-3 py-2 text-sm text-white">
					<option value="" selected?={ data.Filter == "" }>All</option>
					<option value="movie" selected?={ data.Filter == "movie" }>Movies</option>
					<option value="tv" selected?={ data.Filter == "tv" }>TV</option>
				</select>
			</div>
			<button type="submit" class="rounded-lg bg-indigo-600 px-3 py-2 text-sm font-medium text-white hover:bg-indigo-500">Apply</button>
		</form>

		<div>
			<h2 class="text-lg font-semibold mb-3">Wanted queue <span class="text-sm font-normal text-gray-500">({ fmt.Sprintf("%d", data.Total) })</span></h2>
			if len(data.Items) == 0 {
				<div class="rounded-xl border border-gray-800 bg-gray-900/50 p-6 text-center text-sm text-gray-500">Queue is empty.</div>
			} else {
				<div class="overflow-x-auto rounded-xl border border-gray-800">
					<table class="min-w-full divide-y divide-gray-800 text-sm">
						<thead class="bg-gray-900/50">
							<tr>
								<th class="px-4 py-2 text-left text-xs text-gray-500">Title</th>
								<th class="px-4 py-2 text-left text-xs text-gray-500">Type</th>
								<th class="px-4 py-2 text-left text-xs text-gray-500">TMDB</th>
								<th class="px-4 py-2 text-left text-xs text-gray-500">Flags</th>
								<th class="px-4 py-2 text-left text-xs text-gray-500">Updated</th>
								<th class="px-4 py-2 text-right text-xs text-gray-500">Actions</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-gray-800">
							for _, it := range data.Items {
								<tr class="hover:bg-gray-900/40">
									<td class="px-4 py-2 text-gray-200">
										{ it.Title }
										if it.Year > 0 {
											<span class="text-gray-500"> ({ fmt.Sprintf("%d", it.Year) })</span>
										}
									</td>
									<td class="px-4 py-2 text-gray-400">{ it.ItemType }</td>
									<td class="px-4 py-2 text-gray-400">{ fmt.Sprintf("%d", it.TMDBID) }</td>
									<td class="px-4 py-2 text-xs text-gray-400">
										if it.Monitored {
											<span class="text-green-400">monitored</span>
										}
										if it.Missing {
											<span class="text-yellow-400 ml-1">missing</span>
										}
									</td>
									<td class="px-4 py-2 text-xs text-gray-500 truncate max-w-[12rem]">{ it.UpdatedAt }</td>
									<td class="px-4 py-2 text-right whitespace-nowrap">
										<form method="POST" action="/automation/dispatch" class="inline">
											<input type="hidden" name="item_id" value={ it.ItemID }/>
											<input type="hidden" name="item_type" value={ it.ItemType }/>
											<input type="hidden" name="title" value={ it.Title }/>
											<input type="hidden" name="tmdb_id" value={ fmt.Sprintf("%d", it.TMDBID) }/>
											<input type="hidden" name="year" value={ fmt.Sprintf("%d", it.Year) }/>
											<button type="submit" name="fixture" value="1" class="rounded bg-gray-700 px-2 py-1 text-xs text-white hover:bg-gray-600" title="Dispatch fixture magnet (offline)">Fixture</button>
											<button type="submit" class="rounded bg-indigo-600 px-2 py-1 text-xs text-white hover:bg-indigo-500 ml-1" title="Search indexers then dispatch best">Search</button>
										</form>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>

		<div>
			<h2 class="text-lg font-semibold mb-3">Recent history</h2>
			if len(data.History) == 0 {
				<div class="rounded-xl border border-gray-800 bg-gray-900/50 p-6 text-center text-sm text-gray-500">No download history yet.</div>
			} else {
				<ul class="space-y-2">
					for _, h := range data.History {
						<li class="rounded-lg border border-gray-800 bg-gray-900/40 px-3 py-2 text-sm">
							<span class="text-gray-200">{ h.Title }</span>
							<span class="text-gray-500"> · { h.Status }</span>
							if h.Source != "" {
								<span class="text-gray-600"> — { h.Source }</span>
							}
							if h.At != "" {
								<span class="text-xs text-gray-600 float-right">{ h.At }</span>
							}
						</li>
					}
				</ul>
			}
		</div>
	</div>
}
