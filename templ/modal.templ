package templates

templ Modal(id string, title string, children ...templ.Component) {
	<div
		id={ id }
		class="fixed inset-0 z-50 hidden"
		role="dialog"
		aria-modal="true"
	>
		<div class="fixed inset-0 bg-black/60 transition-opacity" onclick={ modalCloseJS(id) }></div>
		<div class="fixed left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-full max-w-md rounded-xl border border-gray-800 bg-gray-900 p-6 shadow-xl">
			<div class="flex items-center justify-between mb-4">
				<h3 class="text-lg font-semibold text-gray-200">{ title }</h3>
				<button
					type="button"
					class="text-gray-500 hover:text-gray-300 transition-colors"
					onclick={ modalCloseJS(id) }
				>
					<span class="text-lg">&times;</span>
				</button>
			</div>
			{ children... }
		</div>
	</div>
}

templ ConfirmDeleteModal(id string, title string, message string, deleteURL string) {
	@Modal(id, title) {
		<p class="text-sm text-gray-400 mb-6">{ message }</p>
		<div class="flex justify-end gap-3">
			<button
				type="button"
				class="rounded-lg border border-gray-700 px-4 py-2 text-sm font-medium text-gray-300 hover:bg-gray-800 transition-colors"
				onclick={ modalCloseJS(id) }
			>Cancel</button>
			<button
				type="button"
				class="rounded-lg bg-red-600 px-4 py-2 text-sm font-medium text-white hover:bg-red-500 transition-colors"
				hx-delete={ deleteURL }
				hx-target="main"
				hx-swap="innerHTML"
				onclick={ modalCloseJS(id) }
			>Confirm</button>
		</div>
	}
}

func modalCloseJS(id string) templ.ComponentScript {
	return templ.ComponentScript{
		Name: "modalClose",
		Function: `function modalClose(id) {
			document.getElementById(id).classList.add('hidden');
		}`,
		Call: templ.SafeScript("modalClose", id),
	}
}
