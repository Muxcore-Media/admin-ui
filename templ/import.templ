package templates

type ImportCandidateRow struct {
	Path string
	Name string
	Size int64
}

type ManualImportPageData struct {
	Candidates []ImportCandidateRow
	Error      string
	Flash      string
}

templ ManualImportPage(data ManualImportPageData) {
	<div class="space-y-6" data-testid="manual-import-page">
		<div>
			<h1 class="text-2xl font-bold">Manual import</h1>
			<p class="text-gray-400 text-sm mt-1">Media files in scanner watch directories that are not yet imported</p>
		</div>
		if data.Flash != "" {
			<div class="rounded-xl border border-green-900/50 bg-green-950/20 p-4 text-sm text-green-300" role="status">{ data.Flash }</div>
		}
		if data.Error != "" {
			<div class="rounded-xl border border-yellow-900/50 bg-yellow-950/20 p-4 text-sm text-yellow-300" role="alert">{ data.Error }</div>
		}
		if len(data.Candidates) == 0 {
			<div class="rounded-xl border border-gray-800 bg-gray-900/50 p-6 text-center text-sm text-gray-500" role="status">No pending candidates in watch dirs.</div>
		} else {
			<section class="overflow-x-auto rounded-xl border border-gray-800" aria-labelledby="import-candidates-heading">
				<h2 id="import-candidates-heading" class="sr-only">Import candidates</h2>
				<table class="min-w-full divide-y divide-gray-800 text-sm">
					<caption class="sr-only">Pending import candidates</caption>
					<thead class="bg-gray-900/50">
						<tr>
							<th scope="col" class="px-3 py-2 text-left text-xs text-gray-500">File</th>
							<th scope="col" class="px-3 py-2 text-left text-xs text-gray-500">Size</th>
							<th scope="col" class="px-3 py-2 text-right text-xs text-gray-500">Action</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-gray-800">
						for _, c := range data.Candidates {
							<tr>
								<td class="px-3 py-2 text-gray-200">
									<div class="font-medium">{ c.Name }</div>
									<div class="text-xs text-gray-500 truncate max-w-[40rem]" title={ c.Path }>{ c.Path }</div>
								</td>
								<td class="px-3 py-2 text-gray-400 whitespace-nowrap">{ formatBytes(c.Size) }</td>
								<td class="px-3 py-2 text-right">
									<form method="POST" action="/import">
										<input type="hidden" name="path" value={ c.Path }/>
										<button type="submit" class="rounded bg-indigo-600 px-2 py-1 text-xs text-white hover:bg-indigo-500" aria-label={ "Import " + c.Name }>Import</button>
									</form>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</section>
		}
	</div>
}
