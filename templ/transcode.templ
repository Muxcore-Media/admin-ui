package templates

import "fmt"

type TranscodeProfileRow struct {
	ID         string
	Name       string
	VideoCodec string
	AudioCodec string
	Preset     string
	UseGPU     bool
	Container  string
}

type TranscodeJobRow struct {
	ID           string
	InputPath    string
	ProfileName  string
	Status       string
	ProgressPct  string
	Error        string
	CreatedAt    string
	Cancellable  bool
}

type TranscodeHardwareRow struct {
	Name      string
	Type      string
	Encoder   string
	Available bool
}

type TranscodeStepTemplateRow struct {
	ID          string
	Name        string
	Description string
}

type TranscodeSetupOutputRow struct {
	ID               string
	ProfileID        string
	Suffix           string
	ReplaceExtension bool
	Enabled          bool
}

type TranscodeSetupStepRow struct {
	ID         string
	StepType   string
	ConfigJSON string
	Enabled    bool
}

type TranscodeSetupRow struct {
	ID                string
	Name              string
	Enabled           bool
	HoldForReview     bool
	LibraryPaths      string
	Trigger           string
	SourceDisposition string
	ArchivePath       string
	Outputs           []TranscodeSetupOutputRow
	Steps             []TranscodeSetupStepRow
}

type TranscodePipelineRunRow struct {
	ID            string
	SetupName     string
	InputPath     string
	Status        string
	SkipReason    string
	Error         string
	CreatedAt     string
	Outputs       []string
	PendingReview bool
}

type TranscodePageData struct {
	Profiles      []TranscodeProfileRow
	Jobs          []TranscodeJobRow
	Hardware      []TranscodeHardwareRow
	StepTemplates []TranscodeStepTemplateRow
	Setups        []TranscodeSetupRow
	Runs          []TranscodePipelineRunRow
	ReviewRuns    []TranscodePipelineRunRow
	Edit          *TranscodeSetupRow
	FlowInitJSON  string
	Flash         string
	Error         string
	SoftEmpty     bool
}

templ TranscodeAdminPage(data TranscodePageData) {
	<div class="space-y-6 max-w-6xl" data-testid="transcode-page">
		<div class="flex flex-wrap items-end justify-between gap-3">
			<div>
				<h1 class="text-2xl font-bold">Transcoder</h1>
				<p class="text-gray-400 text-sm mt-1">
					Encode jobs, profiles, and hardware — plus pipeline setups when you need them.
				</p>
			</div>
			<div class="flex flex-wrap gap-2">
				<form method="POST" action="/transcode/scan">
					<button type="submit" class="rounded-lg border border-gray-700 px-3 py-2 text-sm text-gray-200 hover:bg-gray-800">Scan libraries</button>
				</form>
				<a href="/transcode/edit" class="rounded-lg bg-indigo-600 px-3 py-2 text-sm font-medium text-white hover:bg-indigo-500">New setup</a>
			</div>
		</div>
		if data.SoftEmpty {
			<div class="rounded-xl border border-gray-800 bg-gray-900/50 p-4 text-sm text-gray-400" data-testid="transcode-soft-empty">
				media-transcoder not registered — deploy the module to see encode jobs, profiles, and hardware.
			</div>
		}
		if data.Flash != "" {
			<div class="rounded-lg border border-emerald-800/50 bg-emerald-950/30 px-4 py-2 text-sm text-emerald-300">{ data.Flash }</div>
		}
		if data.Error != "" {
			<div class="rounded-lg border border-red-800/50 bg-red-950/30 px-4 py-2 text-sm text-red-300">{ data.Error }</div>
		}
		if !data.SoftEmpty {
			<div class="rounded-xl border border-gray-800 overflow-hidden" data-testid="transcode-jobs">
				<div class="border-b border-gray-800 bg-gray-900/50 px-4 py-3 text-sm font-semibold text-gray-300">Jobs</div>
				if len(data.Jobs) == 0 {
					<div class="px-4 py-6 text-sm text-gray-500" data-testid="transcode-jobs-empty">No transcode jobs.</div>
				} else {
					<table class="w-full text-sm">
						<thead>
							<tr class="border-b border-gray-800 bg-gray-900/30">
								<th class="text-left px-4 py-2 text-xs text-gray-500 uppercase" scope="col">Input</th>
								<th class="text-left px-4 py-2 text-xs text-gray-500 uppercase" scope="col">Profile</th>
								<th class="text-left px-4 py-2 text-xs text-gray-500 uppercase" scope="col">Status</th>
								<th class="text-left px-4 py-2 text-xs text-gray-500 uppercase" scope="col">Progress</th>
								<th class="text-left px-4 py-2 text-xs text-gray-500 uppercase" scope="col">Action</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-gray-800">
							for _, j := range data.Jobs {
								<tr>
									<td class="px-4 py-2 font-mono text-xs text-gray-400 truncate max-w-xs">{ j.InputPath }</td>
									<td class="px-4 py-2 text-gray-300">{ j.ProfileName }</td>
									<td class="px-4 py-2 text-gray-300">{ j.Status }</td>
									<td class="px-4 py-2 text-gray-300">{ j.ProgressPct }</td>
									<td class="px-4 py-2">
										if j.Cancellable {
											<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/transcode/jobs/%s/cancel", j.ID)) }>
												<button type="submit" class="text-sm text-amber-300 hover:text-amber-200">Cancel</button>
											</form>
										} else if j.Error != "" {
											<span class="text-xs text-red-400">{ j.Error }</span>
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				}
			</div>
			<div class="rounded-xl border border-gray-800 overflow-hidden" data-testid="transcode-profiles">
				<div class="border-b border-gray-800 bg-gray-900/50 px-4 py-3 text-sm font-semibold text-gray-300">Profiles</div>
				if len(data.Profiles) == 0 {
					<div class="px-4 py-6 text-sm text-gray-500">No encode profiles.</div>
				} else {
					<table class="w-full text-sm">
						<thead>
							<tr class="border-b border-gray-800 bg-gray-900/30">
								<th class="text-left px-4 py-2 text-xs text-gray-500 uppercase" scope="col">Name</th>
								<th class="text-left px-4 py-2 text-xs text-gray-500 uppercase" scope="col">Video</th>
								<th class="text-left px-4 py-2 text-xs text-gray-500 uppercase" scope="col">Audio</th>
								<th class="text-left px-4 py-2 text-xs text-gray-500 uppercase" scope="col">GPU</th>
								<th class="text-left px-4 py-2 text-xs text-gray-500 uppercase" scope="col">Container</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-gray-800">
							for _, p := range data.Profiles {
								<tr>
									<td class="px-4 py-2 text-gray-200">{ p.Name }</td>
									<td class="px-4 py-2 font-mono text-xs text-gray-400">{ p.VideoCodec }</td>
									<td class="px-4 py-2 font-mono text-xs text-gray-400">{ p.AudioCodec }</td>
									<td class="px-4 py-2 text-gray-300">
										if p.UseGPU {
											<span>GPU</span>
										} else {
											<span>CPU</span>
										}
									</td>
									<td class="px-4 py-2 font-mono text-xs text-gray-400">{ p.Container }</td>
								</tr>
							}
						</tbody>
					</table>
				}
			</div>
			<div class="rounded-xl border border-gray-800 overflow-hidden" data-testid="transcode-hardware">
				<div class="border-b border-gray-800 bg-gray-900/50 px-4 py-3 text-sm font-semibold text-gray-300">Hardware</div>
				if len(data.Hardware) == 0 {
					<div class="px-4 py-6 text-sm text-gray-500" data-testid="transcode-hardware-empty">No hardware accelerators detected.</div>
				} else {
					<table class="w-full text-sm">
						<thead>
							<tr class="border-b border-gray-800 bg-gray-900/30">
								<th class="text-left px-4 py-2 text-xs text-gray-500 uppercase" scope="col">Device</th>
								<th class="text-left px-4 py-2 text-xs text-gray-500 uppercase" scope="col">Type</th>
								<th class="text-left px-4 py-2 text-xs text-gray-500 uppercase" scope="col">Encoder</th>
								<th class="text-left px-4 py-2 text-xs text-gray-500 uppercase" scope="col">Available</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-gray-800">
							for _, d := range data.Hardware {
								<tr>
									<td class="px-4 py-2 text-gray-200">{ d.Name }</td>
									<td class="px-4 py-2 font-mono text-xs text-gray-400">{ d.Type }</td>
									<td class="px-4 py-2 font-mono text-xs text-gray-400">{ d.Encoder }</td>
									<td class="px-4 py-2 text-gray-300">
										if d.Available {
											<span>yes</span>
										} else {
											<span>no</span>
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				}
			</div>
		}
		if data.Edit != nil {
			@TranscodeSetupForm(data)
		}
		<div class="rounded-xl border border-gray-800 overflow-hidden">
			<div class="border-b border-gray-800 bg-gray-900/50 px-4 py-3 text-sm font-semibold text-gray-300">Setups</div>
			if len(data.Setups) == 0 {
				<div class="px-4 py-6 text-sm text-gray-500">No setups yet.</div>
			} else {
				<div class="divide-y divide-gray-800">
					for _, s := range data.Setups {
						<div class="px-4 py-3 flex flex-wrap items-start justify-between gap-3">
							<div>
								<div class="text-sm font-medium text-gray-200">{ s.Name }</div>
								<div class="text-xs text-gray-500 font-mono">{ s.ID }</div>
								<div class="text-xs text-gray-500 mt-1">
									{ s.Trigger } · { s.SourceDisposition }
									if s.HoldForReview {
										<span>· hold for review</span>
									}
									<span>· { len(s.Outputs) } output(s)</span>
								</div>
								<div class="text-xs text-gray-500 font-mono truncate max-w-xl">{ s.LibraryPaths }</div>
							</div>
							<div class="flex gap-2 text-sm">
								<a href={ templ.SafeURL(fmt.Sprintf("/transcode/edit?id=%s", s.ID)) } class="text-indigo-400 hover:text-indigo-300">Edit</a>
								<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/transcode/delete/%s", s.ID)) }>
									<button type="submit" class="text-red-400 hover:text-red-300">Delete</button>
								</form>
							</div>
						</div>
					}
				</div>
			}
		</div>
		if len(data.ReviewRuns) > 0 {
			<div class="rounded-xl border border-amber-900/40 overflow-hidden" data-testid="transcode-review-queue">
				<div class="border-b border-amber-900/40 bg-amber-950/20 px-4 py-3 text-sm font-semibold text-amber-200">Review queue</div>
				<div class="divide-y divide-gray-800">
					for _, r := range data.ReviewRuns {
						<div class="px-4 py-3 flex flex-wrap items-start justify-between gap-3">
							<div>
								<div class="text-sm font-medium text-gray-200">{ r.SetupName }</div>
								<div class="text-xs text-gray-500 font-mono truncate max-w-xl">{ r.InputPath }</div>
								if len(r.Outputs) > 0 {
									<div class="text-xs text-gray-500 mt-1 font-mono">
										for i, out := range r.Outputs {
											if i > 0 {
												<span>· </span>
											}
											<span>{ out }</span>
										}
									</div>
								}
							</div>
							<div class="flex gap-2 text-sm">
								<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/transcode/review/%s/approve", r.ID)) }>
									<button type="submit" class="rounded-lg bg-emerald-700 px-3 py-1.5 text-white hover:bg-emerald-600">Approve</button>
								</form>
								<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/transcode/review/%s/reject", r.ID)) }>
									<button type="submit" class="rounded-lg border border-red-800 px-3 py-1.5 text-red-300 hover:bg-red-950/40">Reject</button>
								</form>
							</div>
						</div>
					}
				</div>
			</div>
		}
		<div class="rounded-xl border border-gray-800 overflow-hidden">
			<div class="border-b border-gray-800 bg-gray-900/50 px-4 py-3 text-sm font-semibold text-gray-300">Recent pipeline runs</div>
			if len(data.Runs) == 0 {
				<div class="px-4 py-6 text-sm text-gray-500">No runs yet.</div>
			} else {
				<table class="w-full text-sm">
					<thead>
						<tr class="border-b border-gray-800 bg-gray-900/30">
							<th class="text-left px-4 py-2 text-xs text-gray-500 uppercase">Setup</th>
							<th class="text-left px-4 py-2 text-xs text-gray-500 uppercase">Input</th>
							<th class="text-left px-4 py-2 text-xs text-gray-500 uppercase">Status</th>
							<th class="text-left px-4 py-2 text-xs text-gray-500 uppercase">When</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-gray-800">
						for _, r := range data.Runs {
							<tr>
								<td class="px-4 py-2 text-gray-300">{ r.SetupName }</td>
								<td class="px-4 py-2 font-mono text-xs text-gray-500 truncate max-w-xs">{ r.InputPath }</td>
								<td class="px-4 py-2 text-gray-300">{ r.Status }</td>
								<td class="px-4 py-2 text-xs text-gray-500">{ r.CreatedAt }</td>
							</tr>
						}
					</tbody>
				</table>
			}
		</div>
	</div>
}

templ TranscodeSetupForm(data TranscodePageData) {
	<form method="POST" action="/transcode/save" class="space-y-4 rounded-xl border border-indigo-900/40 bg-gray-900/50 p-4">
		<h2 class="text-sm font-semibold text-gray-200">
			if data.Edit.ID == "" {
				New setup
			} else {
				Edit setup
			}
		</h2>
		<input type="hidden" name="id" value={ data.Edit.ID }/>
		<label class="block space-y-1 text-sm">
			<span class="text-gray-400">Name</span>
			<input name="name" required value={ data.Edit.Name } class="w-full rounded-lg border border-gray-700 bg-gray-950 px-3 py-2 text-sm"/>
		</label>
		<label class="flex items-center gap-2 text-sm text-gray-300">
			if data.Edit.Enabled {
				<input type="checkbox" name="enabled" value="1" checked class="rounded border-gray-600"/>
			} else {
				<input type="checkbox" name="enabled" value="1" class="rounded border-gray-600"/>
			}
			<span>Enabled</span>
		</label>
		<label class="flex items-center gap-2 text-sm text-gray-300">
			if data.Edit.HoldForReview {
				<input type="checkbox" name="hold_for_review" value="1" checked class="rounded border-gray-600"/>
			} else {
				<input type="checkbox" name="hold_for_review" value="1" class="rounded border-gray-600"/>
			}
			<span>Hold for review before destructive source action (replace / delete / archive)</span>
		</label>
		<label class="block space-y-1 text-sm">
			<span class="text-gray-400">Library paths (one prefix per line)</span>
			<textarea name="library_paths" rows="3" class="w-full rounded-lg border border-gray-700 bg-gray-950 px-3 py-2 text-sm font-mono">{ data.Edit.LibraryPaths }</textarea>
		</label>
		<div class="grid grid-cols-1 md:grid-cols-3 gap-3">
			<label class="block space-y-1 text-sm">
				<span class="text-gray-400">Trigger</span>
				<select name="trigger" class="w-full rounded-lg border border-gray-700 bg-gray-950 px-3 py-2 text-sm">
					<option value="on_import" selected?={ data.Edit.Trigger == "on_import" }>On import</option>
					<option value="scheduled" selected?={ data.Edit.Trigger == "scheduled" }>Scheduled scan</option>
					<option value="manual" selected?={ data.Edit.Trigger == "manual" }>Manual only</option>
				</select>
			</label>
			<label class="block space-y-1 text-sm">
				<span class="text-gray-400">After transcode</span>
				<select name="source_disposition" class="w-full rounded-lg border border-gray-700 bg-gray-950 px-3 py-2 text-sm">
					<option value="keep" selected?={ data.Edit.SourceDisposition == "keep" }>Keep original</option>
					<option value="replace" selected?={ data.Edit.SourceDisposition == "replace" }>Replace (delete original)</option>
					<option value="delete" selected?={ data.Edit.SourceDisposition == "delete" }>Delete original</option>
					<option value="archive" selected?={ data.Edit.SourceDisposition == "archive" }>Archive original</option>
				</select>
			</label>
			<label class="block space-y-1 text-sm">
				<span class="text-gray-400">Archive path (if archive)</span>
				<input name="archive_path" value={ data.Edit.ArchivePath } placeholder="/data/archive" class="w-full rounded-lg border border-gray-700 bg-gray-950 px-3 py-2 text-sm font-mono"/>
			</label>
		</div>
		@TranscodeFlowBuilder(data)
		if data.Edit.ID != "" && len(data.StepTemplates) > 0 {
			<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/transcode/apply-template/%s", data.Edit.ID)) } class="flex flex-wrap items-end gap-3 rounded-lg border border-gray-800 bg-gray-950/50 p-3">
				<label class="block space-y-1 text-sm grow min-w-[12rem]">
					<span class="text-gray-400">Community step template</span>
					<select name="template_id" required class="w-full rounded-lg border border-gray-700 bg-gray-950 px-3 py-2 text-sm">
						for _, tpl := range data.StepTemplates {
							<option value={ tpl.ID }>{ tpl.Name }</option>
						}
					</select>
				</label>
				<label class="flex items-center gap-2 text-sm text-gray-300 pb-2">
					<input type="checkbox" name="replace_steps" value="1" class="rounded border-gray-600"/>
					<span>Replace existing steps</span>
				</label>
				<button type="submit" class="rounded-lg border border-indigo-700 px-3 py-2 text-sm text-indigo-200 hover:bg-indigo-950">Apply template</button>
			</form>
		}
		<div class="flex gap-2">
			<button type="submit" class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-500">Save setup</button>
			<a href="/transcode" class="rounded-lg border border-gray-700 px-4 py-2 text-sm text-gray-300">Cancel</a>
		</div>
	</form>
}

templ TranscodeFlowBuilder(data TranscodePageData) {
	<div
		id="transcode-flow-builder"
		class="space-y-4 rounded-xl border border-gray-700 bg-gray-950/40 p-4"
		data-testid="transcode-flow-builder"
		data-init={ data.FlowInitJSON }
	>
		<div class="flex flex-wrap items-center justify-between gap-2">
			<div>
				<h3 class="text-sm font-semibold text-gray-200">Pipeline flow</h3>
				<p class="text-xs text-gray-500 mt-0.5">Drag nodes to reorder. Add filters/actions, then transcode outputs.</p>
			</div>
			<button type="button" id="flow-advanced-toggle" class="text-xs text-indigo-400 hover:text-indigo-300">Show raw text</button>
		</div>
		<input type="hidden" name="steps" id="flow-steps-input" value={ transcodeStepsText(data.Edit.Steps) }/>
		<input type="hidden" name="outputs" id="flow-outputs-input" value={ transcodeOutputsText(data.Edit.Outputs) }/>
		<div class="grid grid-cols-1 lg:grid-cols-[12rem_1fr] gap-4">
			<div id="flow-palette" class="space-y-2">
				<div class="text-xs font-semibold uppercase tracking-wide text-gray-500">Add step</div>
				<button type="button" data-add-step="filter.skip_if_codec" class="w-full rounded border border-gray-700 px-2 py-1.5 text-left text-xs text-gray-300 hover:bg-gray-800">Skip if codec</button>
				<button type="button" data-add-step="filter.skip_if_container" class="w-full rounded border border-gray-700 px-2 py-1.5 text-left text-xs text-gray-300 hover:bg-gray-800">Skip if container</button>
				<button type="button" data-add-step="filter.min_size_mb" class="w-full rounded border border-gray-700 px-2 py-1.5 text-left text-xs text-gray-300 hover:bg-gray-800">Min size</button>
				<button type="button" data-add-step="filter.max_size_mb" class="w-full rounded border border-gray-700 px-2 py-1.5 text-left text-xs text-gray-300 hover:bg-gray-800">Max size</button>
				<button type="button" data-add-step="filter.extension" class="w-full rounded border border-gray-700 px-2 py-1.5 text-left text-xs text-gray-300 hover:bg-gray-800">Extension filter</button>
				<button type="button" data-add-step="filter.skip_if_output_exists" class="w-full rounded border border-gray-700 px-2 py-1.5 text-left text-xs text-gray-300 hover:bg-gray-800">Skip if output exists</button>
				<button type="button" data-add-step="action.remux" class="w-full rounded border border-gray-700 px-2 py-1.5 text-left text-xs text-gray-300 hover:bg-gray-800">Remux</button>
			</div>
			<div class="space-y-3">
				<div class="flex flex-col items-center gap-1">
					<div class="w-full max-w-xl rounded-lg border border-emerald-900/50 bg-emerald-950/20 px-4 py-2 text-center text-sm text-emerald-200">Library file</div>
					<div class="text-gray-600 text-lg leading-none">↓</div>
				</div>
				<div id="flow-steps-list" class="space-y-2 max-w-xl mx-auto w-full"></div>
				<div class="flex flex-col items-center gap-1 max-w-xl mx-auto w-full">
					<div class="text-gray-600 text-lg leading-none">↓</div>
					<div class="w-full rounded-lg border border-indigo-900/40 bg-indigo-950/10 px-4 py-2">
						<div class="flex items-center justify-between gap-2 mb-2">
							<span class="text-sm font-medium text-indigo-200">Transcode outputs</span>
							<button type="button" id="flow-add-output" class="text-xs rounded border border-indigo-800 px-2 py-1 text-indigo-300 hover:bg-indigo-950/40">Add output</button>
						</div>
						<div id="flow-outputs-list" class="space-y-2"></div>
					</div>
					<div class="text-gray-600 text-lg leading-none">↓</div>
					<div id="flow-review-badge" class="hidden w-full rounded border border-amber-900/40 bg-amber-950/20 px-3 py-1.5 text-center text-xs text-amber-200">Hold for review</div>
					<div id="flow-end-label" class="w-full rounded-lg border border-gray-700 bg-gray-900 px-4 py-2 text-center text-sm text-gray-300">Source: keep</div>
				</div>
			</div>
		</div>
		<div id="flow-advanced-panel" class="hidden space-y-3 border-t border-gray-800 pt-3">
			<label class="block space-y-1 text-sm">
				<span class="text-gray-400">Filter / action steps (type,json — one per line)</span>
				<textarea id="flow-steps-text" rows="4" readonly class="w-full rounded-lg border border-gray-700 bg-gray-950 px-3 py-2 text-sm font-mono">{ transcodeStepsText(data.Edit.Steps) }</textarea>
			</label>
			<label class="block space-y-1 text-sm">
				<span class="text-gray-400">Outputs (profile_id,suffix,replace_ext — one per line)</span>
				<textarea id="flow-outputs-text" rows="4" readonly class="w-full rounded-lg border border-gray-700 bg-gray-950 px-3 py-2 text-sm font-mono">{ transcodeOutputsText(data.Edit.Outputs) }</textarea>
			</label>
		</div>
		<script src="/static/transcode-flow.js"></script>
	</div>
}

func transcodeOutputsText(rows []TranscodeSetupOutputRow) string {
	if len(rows) == 0 {
		return "hevc_gpu,-hevc,true"
	}
	var out string
	for i, r := range rows {
		if i > 0 {
			out += "\n"
		}
		rep := "false"
		if r.ReplaceExtension {
			rep = "true"
		}
		out += fmt.Sprintf("%s,%s,%s", r.ProfileID, r.Suffix, rep)
	}
	return out
}

func transcodeStepsText(rows []TranscodeSetupStepRow) string {
	if len(rows) == 0 {
		return `filter.skip_if_codec,{"codecs":["hevc","h265"]}`
	}
	var out string
	for i, r := range rows {
		if i > 0 {
			out += "\n"
		}
		out += fmt.Sprintf("%s,%s", r.StepType, r.ConfigJSON)
	}
	return out
}
