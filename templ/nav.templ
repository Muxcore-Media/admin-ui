package templates

type NavLink struct {
	Label string
	Path  string
	Icon  string
}

templ Nav(links []NavLink, activePath string) {
	<div class="p-4">
		<div class="flex items-center justify-between mb-6">
			<a href="/" class="flex items-center gap-2">
				<div class="w-8 h-8 rounded-lg bg-indigo-600 flex items-center justify-center text-sm font-bold">M</div>
				<span class="text-lg font-bold">MuxCore</span>
			</a>
		</div>

		<div class="relative mb-4" id="search-container">
			<input
				type="text"
				placeholder="Search..."
				class="w-full rounded-lg border border-gray-700 bg-gray-800 px-3 py-2 text-sm text-white placeholder-gray-500 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"
				hx-get="/search"
				hx-trigger="keyup changed delay:300ms"
				hx-target="#search-results"
				hx-swap="innerHTML"
				hx-indicator="#search-spinner"
				name="q"
				autocomplete="off"
			/>
			<div id="search-spinner" class="absolute right-3 top-2.5 htmx-indicator">
				<svg class="animate-spin w-4 h-4 text-gray-500" fill="none" viewBox="0 0 24 24">
					<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
					<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/>
				</svg>
			</div>
			<div id="search-results" class="absolute left-0 right-0 top-full mt-1 rounded-xl border border-gray-700 bg-gray-900 shadow-xl z-50 hidden"
				hx-swap="innerHTML"
				hx-target="this"
			></div>
		</div>

		<ul class="space-y-1">
			for _, link := range links {
				<li>
					<a
						href={ link.Path }
						class={ "flex items-center gap-3 px-3 py-2 rounded-lg text-sm transition-colors",
							templ.KV("bg-gray-800 text-white", activePath == link.Path),
							templ.KV("text-gray-400 hover:text-white hover:bg-gray-800", activePath != link.Path),
						}
					>
						<span class="w-5 h-5 flex items-center justify-center">{ link.Icon }</span>
						{ link.Label }
					</a>
				</li>
			}
		</ul>
	</div>
}
