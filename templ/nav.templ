package templates

type NavLink struct {
	Label string
	Path  string
	Icon  string
	Group string
}

// groupOrder controls section rendering order regardless of slice order.
var groupOrder = []string{"Overview", "Daily admin", "Library", "Media", "Automation", "Playback", "Monitoring", "Advanced"}

templ Nav(links []NavLink, activePath string) {
	<div class="flex h-full flex-col">
		<div class="flex items-center gap-2 px-4 pt-5 pb-4">
			<a href="/" class="flex items-center gap-2.5">
				<div class="flex h-8 w-8 items-center justify-center rounded-[var(--radius-md)] bg-[var(--accent-color)] text-sm font-bold text-black" aria-hidden="true">M</div>
				<span class="text-base font-bold tracking-tight text-[var(--text-primary)]">
					MuxCore <span class="text-[var(--accent-color)]">Admin</span>
				</span>
			</a>
		</div>
		<nav class="flex-1 overflow-y-auto px-3 pb-3" aria-label="Primary">
			for _, group := range groupOrder {
				if len(linksInGroup(links, group)) > 0 {
					<div class={
						templ.KV("mb-4 mt-3 border-t border-[var(--border-subtle)] pt-3", group == "Advanced"),
						templ.KV("mb-4", group != "Advanced"),
					}>
						<div class={
							templ.KV("mb-1.5 px-3 text-[11px] font-semibold tracking-wider text-gray-500 uppercase", group == "Advanced"),
							templ.KV("mb-1.5 px-3 text-[11px] font-semibold tracking-wider text-[var(--text-tertiary)] uppercase", group != "Advanced"),
						}>{ group }</div>
						<ul class="space-y-0.5">
							for _, link := range linksInGroup(links, group) {
								<li>
									<a
										href={ templ.SafeURL(link.Path) }
										data-nav-link="true"
										class={
											"flex items-center gap-2.5 rounded-[var(--radius-md)] px-3 py-1.5 text-sm font-medium transition-colors",
											templ.KV("bg-[var(--accent-color)] text-black", activePath == link.Path),
											templ.KV("text-[var(--text-secondary)] hover:bg-[var(--bg-elevated-2)] hover:text-[var(--text-primary)]", activePath != link.Path),
										}
									>
										@NavIcon(link.Icon)
										<span class="truncate">{ link.Label }</span>
									</a>
								</li>
							}
						</ul>
					</div>
				}
			}
		</nav>
		<div class="border-t border-[var(--border-subtle)] px-3 py-3">
			<a
				href="/logout"
				hx-boost="false"
				class="flex items-center gap-2.5 rounded-[var(--radius-md)] px-3 py-1.5 text-sm font-medium text-[var(--text-secondary)] transition-colors hover:bg-[var(--bg-elevated-2)] hover:text-[var(--text-primary)]"
			>
				@NavIcon("logout")
				Log out
			</a>
		</div>
	</div>
}

func linksInGroup(links []NavLink, group string) []NavLink {
	out := make([]NavLink, 0, len(links))
	for _, l := range links {
		g := l.Group
		if g == "" {
			g = "Media"
		}
		if g == group {
			out = append(out, l)
		}
	}
	return out
}
