package templates

import (
	"fmt"
	"strconv"
	"strings"

	mediaadminv1 "github.com/Muxcore-Media/contracts-media-admin/gen/muxcore/media/admin/v1"
)

func mediaHasFeature(features []mediaadminv1.Feature, name string) bool {
	want := featureFromName(name)
	if want == mediaadminv1.Feature_FEATURE_UNSPECIFIED {
		return false
	}
	for _, f := range features {
		if f == want {
			return true
		}
	}
	return false
}

func featureFromName(name string) mediaadminv1.Feature {
	switch strings.ToLower(strings.TrimSpace(name)) {
	case "missing":
		return mediaadminv1.Feature_FEATURE_MISSING
	case "tags":
		return mediaadminv1.Feature_FEATURE_TAGS
	case "collections":
		return mediaadminv1.Feature_FEATURE_COLLECTIONS
	case "calendar":
		return mediaadminv1.Feature_FEATURE_CALENDAR
	default:
		return mediaadminv1.Feature_FEATURE_UNSPECIFIED
	}
}

func mediaPosterURL(item *mediaadminv1.MediaItem) string {
	for _, a := range item.GetArtwork() {
		if a.GetType() == "poster" && a.GetUrl() != "" {
			return a.GetUrl()
		}
	}
	return ""
}

func mediaListQuery(q, tagID string, page int) string {
	var parts []string
	if q != "" {
		parts = append(parts, "q="+q)
	}
	if tagID != "" {
		parts = append(parts, "tag="+tagID)
	}
	if page > 1 {
		parts = append(parts, "page="+strconv.Itoa(page))
	}
	if len(parts) == 0 {
		return ""
	}
	return "?" + strings.Join(parts, "&")
}

func itemDispatchAction(moduleID, itemID string) string {
	return fmt.Sprintf("/media/%s/item/%s/dispatch", moduleID, itemID)
}

func automationItemTypeForTemplate(moduleID, displayName string) string {
	s := strings.ToLower(moduleID + " " + displayName)
	switch {
	case strings.Contains(s, "movie"):
		return "movie"
	case strings.Contains(s, "tv") || strings.Contains(s, "show"):
		return "tv"
	default:
		return "movie"
	}
}

templ MediaSubnav(moduleID string, displayName string, features []mediaadminv1.Feature, active string) {
	<nav class="flex flex-wrap items-center gap-2 border-b border-gray-800 pb-3" aria-label={ fmt.Sprintf("%s library navigation", displayName) }>
		<span class="text-sm font-semibold text-gray-300 mr-2">{ displayName }</span>
		<a
			href={ templ.SafeURL(fmt.Sprintf("/media/%s", moduleID)) }
			class={ "text-sm px-2 py-1 rounded", templ.KV("bg-indigo-600 text-white", active == "browse"), templ.KV("text-gray-400 hover:text-white", active != "browse") }
			if active == "browse" {
				aria-current="page"
			}
		>Browse</a>
		if mediaHasFeature(features, "missing") {
			<a
				href={ templ.SafeURL(fmt.Sprintf("/media/%s/missing", moduleID)) }
				class={ "text-sm px-2 py-1 rounded", templ.KV("bg-indigo-600 text-white", active == "missing"), templ.KV("text-gray-400 hover:text-white", active != "missing") }
				if active == "missing" {
					aria-current="page"
				}
			>Missing</a>
		}
		if mediaHasFeature(features, "tags") {
			<a
				href={ templ.SafeURL(fmt.Sprintf("/media/%s/tags", moduleID)) }
				class={ "text-sm px-2 py-1 rounded", templ.KV("bg-indigo-600 text-white", active == "tags"), templ.KV("text-gray-400 hover:text-white", active != "tags") }
				if active == "tags" {
					aria-current="page"
				}
			>Tags</a>
		}
		if mediaHasFeature(features, "collections") {
			<a
				href={ templ.SafeURL(fmt.Sprintf("/media/%s/collections", moduleID)) }
				class={ "text-sm px-2 py-1 rounded", templ.KV("bg-indigo-600 text-white", active == "collections"), templ.KV("text-gray-400 hover:text-white", active != "collections") }
				if active == "collections" {
					aria-current="page"
				}
			>Collections</a>
		}
		if mediaHasFeature(features, "calendar") {
			<a
				href={ templ.SafeURL(fmt.Sprintf("/media/%s/calendar", moduleID)) }
				class={ "text-sm px-2 py-1 rounded", templ.KV("bg-indigo-600 text-white", active == "calendar"), templ.KV("text-gray-400 hover:text-white", active != "calendar") }
				if active == "calendar" {
					aria-current="page"
				}
			>Calendar</a>
		}
	</nav>
}

templ MediaListPage(displayName string, items []*mediaadminv1.MediaItem, total, page, pageSize int, moduleID string, features []mediaadminv1.Feature, search, tagID string) {
	<div class="space-y-6" data-testid="media-list-page">
		@MediaSubnav(moduleID, displayName, features, "browse")
		<div>
			<h1 class="text-2xl font-bold">{ displayName }</h1>
			if items != nil {
				<p class="text-gray-400 text-sm mt-1" data-testid="media-item-count" aria-live="polite">{ strconv.Itoa(total) } items</p>
			}
		</div>
		<section aria-labelledby="media-search-heading">
			<h2 id="media-search-heading" class="sr-only">Search library</h2>
			<form method="get" action={ templ.SafeURL(fmt.Sprintf("/media/%s", moduleID)) } class="flex flex-wrap gap-2 items-end">
				<div>
					<label for="media-search-query" class="block text-xs font-medium text-gray-500 mb-1">Search</label>
					<input
						id="media-search-query"
						type="search"
						name="q"
						value={ search }
						placeholder="Search…"
						class="rounded-lg border border-gray-700 bg-gray-800 px-3 py-2 text-sm min-w-[12rem]"
					/>
				</div>
				if tagID != "" {
					<input type="hidden" name="tag" value={ tagID }/>
				}
				<button type="submit" class="rounded-lg bg-indigo-600 px-3 py-2 text-sm font-semibold text-white hover:bg-indigo-500">Search</button>
			</form>
		</section>
		if items == nil {
			<div class="rounded-xl border border-gray-800 bg-gray-900/50 p-8 text-center" data-testid="media-soft-empty" role="status">
				<p class="text-gray-400">Soft OK without this library module — empty until it is registered or reachable.</p>
			</div>
		} else if len(items) == 0 {
			<div class="rounded-xl border border-gray-800 bg-gray-900/50 p-8 text-center" data-testid="media-empty" role="status">
				<p class="text-gray-400">No items found.</p>
			</div>
		} else {
			<section aria-labelledby="media-items-heading">
				<h2 id="media-items-heading" class="sr-only">Library items</h2>
				<ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4" role="list">
					for _, item := range items {
						<li>
							@MediaItemCard(item, moduleID)
						</li>
					}
				</ul>
			</section>
			if total > pageSize {
				<nav class="mt-4 flex items-center justify-center gap-2" aria-label="Library pagination">
					if page > 1 {
						<a
							href={ templ.SafeURL(fmt.Sprintf("/media/%s%s", moduleID, mediaListQuery(search, tagID, page-1))) }
							class="rounded-lg border border-gray-700 px-3 py-1.5 text-sm text-gray-300 hover:bg-gray-800"
							aria-label="Previous page"
						>Prev</a>
					}
					<span class="text-sm text-gray-500" aria-current="page">Page { strconv.Itoa(page) }</span>
					if page*pageSize < total {
						<a
							href={ templ.SafeURL(fmt.Sprintf("/media/%s%s", moduleID, mediaListQuery(search, tagID, page+1))) }
							class="rounded-lg border border-gray-700 px-3 py-1.5 text-sm text-gray-300 hover:bg-gray-800"
							aria-label="Next page"
						>Next</a>
					}
				</nav>
			}
		}
	</div>
}

templ MediaItemCard(item *mediaadminv1.MediaItem, moduleID string) {
	<a
		href={ templ.SafeURL(fmt.Sprintf("/media/%s/item/%s", moduleID, item.GetId())) }
		class="block rounded-xl border border-gray-800 bg-gray-900/50 p-4 hover:border-gray-700 transition-colors"
		aria-label={ fmt.Sprintf("Open %s", item.GetTitle()) }
	>
		if mediaPosterURL(item) != "" {
			<img
				src={ templ.SafeURL(mediaPosterURL(item)) }
				alt={ item.GetTitle() }
				class="aspect-[2/3] rounded-lg w-full object-cover mb-3 bg-gray-800"
				loading="lazy"
			/>
		} else {
			<div class="aspect-[2/3] rounded-lg bg-gray-800 mb-3 flex items-center justify-center text-gray-600 text-4xl">
				?
			</div>
		}
		<h3 class="text-sm font-semibold text-white truncate">{ item.GetTitle() }</h3>
		if item.GetYear() > 0 {
			<p class="text-xs text-gray-500 mt-1">{ strconv.FormatInt(item.GetYear(), 10) }</p>
		}
		if len(item.GetGenres()) > 0 {
			<div class="flex flex-wrap gap-1 mt-2">
				for _, g := range item.GetGenres() {
					<span class="text-xs px-1.5 py-0.5 rounded bg-gray-800 text-gray-400">{ g }</span>
				}
			</div>
		}
	</a>
}

templ MediaDetailPage(item *mediaadminv1.MediaItem, moduleID string, history []ActivityEntry, profiles []ProfileOption, roots []RootOption, features []mediaadminv1.Feature, displayName string, releases []*mediaadminv1.IndexerResult, seasons []SeasonView, files []MediaFileView, titles []AlternateTitleView, trailers []TrailerView, flash, flashStatus, errorMsg string) {
	<div class="space-y-6">
		@MediaSubnav(moduleID, displayName, features, "")
		<a href={ templ.SafeURL(fmt.Sprintf("/media/%s", moduleID)) } class="text-sm text-indigo-400 hover:text-indigo-300">&larr; Back</a>
		if flash != "" {
			<div class="rounded-xl border border-green-900/50 bg-green-950/20 p-4 text-sm text-green-300" data-testid="dispatch-flash">
				Dispatched download_id={ flash }
				if flashStatus != "" {
					<span class="text-gray-400">status={ flashStatus }</span>
				}
			</div>
		}
		if flashStatus == "refreshed" {
			<div class="rounded-xl border border-green-900/50 bg-green-950/20 p-4 text-sm text-green-300" data-testid="refresh-flash">Metadata refreshed</div>
		}
		if errorMsg != "" {
			<div class="rounded-xl border border-yellow-900/50 bg-yellow-950/20 p-4 text-sm text-yellow-300">{ errorMsg }</div>
		}
		<div class="flex flex-wrap gap-2" data-testid="item-actions">
			<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/media/%s/item/%s/refresh", moduleID, item.GetId())) }>
				<button type="submit" class="rounded-lg border border-gray-700 px-3 py-1.5 text-sm text-gray-300 hover:bg-gray-800" data-testid="item-refresh">Refresh metadata</button>
			</form>
			<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/media/%s/item/%s/delete", moduleID, item.GetId())) } onsubmit="return confirm('Remove this library item?');">
				<label class="mr-2 inline-flex items-center gap-1 text-xs text-gray-500">
					<input type="checkbox" name="delete_files" value="1"/> Delete files
				</label>
				<button type="submit" class="rounded-lg border border-red-900/60 px-3 py-1.5 text-sm text-red-300 hover:bg-red-950/40" data-testid="item-delete">Delete</button>
			</form>
		</div>
		<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
			<div class="lg:col-span-1">
				if mediaPosterURL(item) != "" {
					<img
						src={ templ.SafeURL(mediaPosterURL(item)) }
						alt={ item.GetTitle() }
						class="aspect-[2/3] rounded-xl w-full object-cover bg-gray-800"
					/>
				} else {
					<div class="aspect-[2/3] rounded-xl bg-gray-800 flex items-center justify-center text-gray-600 text-6xl">
						?
					</div>
				}
			</div>
			<div class="lg:col-span-2 space-y-4">
				<div>
					<h1 class="text-2xl font-bold">{ item.GetTitle() }</h1>
					if item.GetYear() > 0 {
						<p class="text-gray-400 text-sm">{ strconv.FormatInt(item.GetYear(), 10) }</p>
					}
				</div>
				if item.GetDescription() != "" {
					<div>
						<h3 class="text-sm font-semibold text-gray-300 mb-1">Description</h3>
						<p class="text-sm text-gray-400">{ item.GetDescription() }</p>
					</div>
				}
				<div>
					<h3 class="text-sm font-semibold text-gray-300 mb-1">Metadata</h3>
					<form
						hx-post={ templ.SafeURL(fmt.Sprintf("/media/%s/item/%s/metadata", moduleID, item.GetId())) }
						hx-target="this"
						hx-swap="outerHTML"
						class="space-y-3"
					>
						<input type="hidden" name="has_monitored" value="1"/>
						<div>
							<label class="block text-xs text-gray-500 mb-1">Title</label>
							<input
								type="text"
								name="title"
								value={ item.GetTitle() }
								class="w-full rounded-lg border border-gray-700 bg-gray-800 px-3 py-2 text-sm"
							/>
						</div>
						<div>
							<label class="block text-xs text-gray-500 mb-1">Description</label>
							<textarea
								name="description"
								rows="3"
								class="w-full rounded-lg border border-gray-700 bg-gray-800 px-3 py-2 text-sm"
							>{ item.GetDescription() }</textarea>
						</div>
						<label class="flex items-center gap-2 text-sm text-gray-300">
							if item.GetMetadata()["monitored"] == "true" {
								<input type="checkbox" name="monitored" value="true" checked data-testid="item-monitored"/>
							} else {
								<input type="checkbox" name="monitored" value="true" data-testid="item-monitored"/>
							}
							Monitored
						</label>
						for k, v := range item.GetMetadata() {
							if k == "monitored" {
							} else if k == "series_type" {
								<div>
									<label class="block text-xs text-gray-500 mb-1">Series type</label>
									<select name="series_type" class="w-full rounded-lg border border-gray-700 bg-gray-800 px-3 py-2 text-sm" data-testid="item-series-type">
										for _, opt := range []string{"standard", "daily", "anime"} {
											if opt == v || (v == "" && opt == "standard") {
												<option value={ opt } selected>{ opt }</option>
											} else {
												<option value={ opt }>{ opt }</option>
											}
										}
									</select>
								</div>
							} else if k == "minimum_availability" {
								<div>
									<label class="block text-xs text-gray-500 mb-1">Minimum availability</label>
									<select name="minimum_availability" class="w-full rounded-lg border border-gray-700 bg-gray-800 px-3 py-2 text-sm" data-testid="item-min-availability">
										for _, opt := range []string{"announced", "inCinemas", "released", "preDB"} {
											if opt == v || (v == "" && opt == "released") {
												<option value={ opt } selected>{ opt }</option>
											} else {
												<option value={ opt }>{ opt }</option>
											}
										}
									</select>
								</div>
							} else if k == "quality_profile_id" && len(profiles) > 0 {
								<div>
									<label class="block text-xs text-gray-500 mb-1">Quality Profile</label>
									<select name="quality_profile_id" class="w-full rounded-lg border border-gray-700 bg-gray-800 px-3 py-2 text-sm">
										<option value="">—</option>
										for _, p := range profiles {
											if p.ID == v {
												<option value={ p.ID } selected>{ p.Name }</option>
											} else {
												<option value={ p.ID }>{ p.Name }</option>
											}
										}
									</select>
								</div>
							} else if k == "root_folder_path" && len(roots) > 0 {
								<div>
									<label class="block text-xs text-gray-500 mb-1">Root Folder</label>
									<select name="root_folder_path" class="w-full rounded-lg border border-gray-700 bg-gray-800 px-3 py-2 text-sm">
										<option value="">—</option>
										for _, root := range roots {
											if root.Path == v {
												<option value={ root.Path } selected>{ root.Name } ({ root.Path })</option>
											} else {
												<option value={ root.Path }>{ root.Name } ({ root.Path })</option>
											}
										}
									</select>
								</div>
							} else {
								<div>
									<label class="block text-xs text-gray-500 mb-1">{ k }</label>
									<input
										type="text"
										name={ k }
										value={ v }
										class="w-full rounded-lg border border-gray-700 bg-gray-800 px-3 py-2 text-sm"
									/>
								</div>
							}
						}
						<button
							type="submit"
							class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-500 transition-colors"
						>Save</button>
					</form>
				</div>
			</div>
		</div>
		if len(files) > 0 {
			<div data-testid="media-files" class="space-y-3">
				<h2 class="text-lg font-semibold">Files</h2>
				<div class="overflow-x-auto rounded-xl border border-gray-800">
					<table class="min-w-full divide-y divide-gray-800 text-sm">
						<thead class="bg-gray-900/50">
							<tr>
								<th class="px-3 py-2 text-left text-xs text-gray-500">Path</th>
								<th class="px-3 py-2 text-left text-xs text-gray-500">Quality</th>
								<th class="px-3 py-2 text-left text-xs text-gray-500">Size</th>
								<th class="px-3 py-2 text-right text-xs text-gray-500">Actions</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-gray-800">
							for _, f := range files {
								<tr>
									<td class="px-3 py-2 text-gray-300 truncate max-w-[28rem]" title={ f.Path }>{ f.Path }</td>
									<td class="px-3 py-2 text-gray-400">{ f.Quality }</td>
									<td class="px-3 py-2 text-gray-400">{ formatBytes(f.Size) }</td>
									<td class="px-3 py-2 text-right">
										<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/media/%s/item/%s/files/%s/delete", moduleID, item.GetId(), f.ID)) } class="inline">
											<label class="mr-2 text-xs text-gray-500"><input type="checkbox" name="delete_files" value="1"/> delete from disk</label>
											<button type="submit" class="text-xs text-red-300 hover:underline">Remove</button>
										</form>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
		}
		<div id="alternate-titles" class="space-y-3" data-testid="alternate-titles">
			<h2 class="text-lg font-semibold">Alternate titles</h2>
			if len(titles) > 0 {
				<ul class="space-y-2 rounded-xl border border-gray-800 bg-gray-900/40 p-3">
					for _, t := range titles {
						<li class="flex items-center justify-between gap-3 text-sm">
							<span class="text-gray-200">{ t.Title } <span class="text-xs text-gray-500">({ t.Source })</span></span>
							<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/media/%s/item/%s/titles/%s/delete", moduleID, item.GetId(), t.ID)) }>
								<button type="submit" class="text-xs text-red-400 hover:underline">Remove</button>
							</form>
						</li>
					}
				</ul>
			} else {
				<p class="text-sm text-gray-500">No alternate titles yet.</p>
			}
			<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/media/%s/item/%s/titles", moduleID, item.GetId())) } class="flex flex-wrap gap-2">
				<input type="text" name="title" required placeholder="Add alternate title" class="flex-1 min-w-[12rem] rounded-lg border border-gray-700 bg-gray-800 px-3 py-2 text-sm"/>
				<button type="submit" class="rounded-lg bg-indigo-600 px-3 py-2 text-sm font-medium text-white hover:bg-indigo-500">Add</button>
			</form>
		</div>
		if len(trailers) > 0 {
			<div id="trailers" class="space-y-3" data-testid="trailers">
				<h2 class="text-lg font-semibold">Trailers &amp; extras</h2>
				<ul class="space-y-2 rounded-xl border border-gray-800 bg-gray-900/40 p-3">
					for _, t := range trailers {
						<li class="flex items-center justify-between gap-3 text-sm">
							<span class="text-gray-200">{ t.Name } <span class="text-xs text-gray-500">({ t.Type })</span></span>
							<a href={ templ.SafeURL(t.URL) } target="_blank" rel="noopener" class="text-xs text-indigo-400 hover:underline">Open</a>
						</li>
					}
				</ul>
			</div>
		}
		if len(seasons) > 0 {
			<div id="seasons" class="space-y-3" data-testid="season-tree">
				<h2 class="text-lg font-semibold">Seasons &amp; episodes</h2>
				for _, season := range seasons {
					<details class="rounded-xl border border-gray-800 bg-gray-900/40 p-4">
						<summary class="flex flex-wrap items-center justify-between gap-3 cursor-pointer">
							<span class="font-medium text-gray-200">
								if season.Name != "" {
									Season { strconv.Itoa(season.Number) }: { season.Name }
								} else {
									Season { strconv.Itoa(season.Number) }
								}
								<span class="text-xs text-gray-500 ml-2">{ strconv.Itoa(len(season.Episodes)) } eps</span>
							</span>
							<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/media/%s/item/%s/season/%s/monitor", moduleID, item.GetId(), season.ID)) } class="inline" onclick="event.stopPropagation()">
								if season.Monitored {
									<input type="hidden" name="monitored" value="false"/>
									<button type="submit" class="rounded border border-green-900/50 px-2 py-1 text-xs text-green-300 hover:bg-green-950/30">Monitored</button>
								} else {
									<input type="hidden" name="monitored" value="true"/>
									<button type="submit" class="rounded border border-gray-700 px-2 py-1 text-xs text-gray-400 hover:bg-gray-800">Unmonitored</button>
								}
							</form>
						</summary>
						<div class="mt-3 overflow-x-auto">
							<table class="min-w-full divide-y divide-gray-800 text-sm">
								<thead>
									<tr class="text-xs text-gray-500">
										<th class="px-2 py-1 text-left">Ep</th>
										<th class="px-2 py-1 text-left">Title</th>
										<th class="px-2 py-1 text-left">Air</th>
										<th class="px-2 py-1 text-left">File</th>
										<th class="px-2 py-1 text-right">Monitor</th>
										<th class="px-2 py-1 text-right">Actions</th>
									</tr>
								</thead>
								<tbody class="divide-y divide-gray-800">
									for _, ep := range season.Episodes {
										<tr>
											<td class="px-2 py-1 text-gray-400 whitespace-nowrap">
												E{ strconv.Itoa(ep.Number) }
												if ep.Absolute > 0 {
													<span class="text-gray-600">(abs { strconv.Itoa(ep.Absolute) })</span>
												}
											</td>
											<td class="px-2 py-1 text-gray-200">{ ep.Name }</td>
											<td class="px-2 py-1 text-gray-500 whitespace-nowrap">{ ep.AirDate }</td>
											<td class="px-2 py-1 text-xs">
												if ep.HasFile {
													<span class="text-green-400">yes</span>
												} else {
													<span class="text-gray-500">no</span>
												}
											</td>
											<td class="px-2 py-1 text-right">
												<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/media/%s/item/%s/episode/%s/monitor", moduleID, item.GetId(), ep.ID)) } class="inline">
													if ep.Monitored {
														<input type="hidden" name="monitored" value="false"/>
														<button type="submit" class="text-xs text-green-300 hover:underline">on</button>
													} else {
														<input type="hidden" name="monitored" value="true"/>
														<button type="submit" class="text-xs text-gray-500 hover:underline">off</button>
													}
												</form>
											</td>
											<td class="px-2 py-1 text-right whitespace-nowrap">
												if ep.HasFile {
													<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/media/%s/item/%s/episode/%s/files/delete", moduleID, item.GetId(), ep.ID)) } class="inline">
														<label class="mr-2 text-[10px] text-gray-500">
															<input type="checkbox" name="delete_files" value="1" class="align-middle"/> disk
														</label>
														<button type="submit" class="text-xs text-red-400 hover:underline" data-testid="episode-file-delete">Remove file</button>
													</form>
												}
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					</details>
				}
			</div>
		}
		<div id="artwork-section" hx-get={ templ.SafeURL(fmt.Sprintf("/media/%s/item/%s/artwork", moduleID, item.GetId())) } hx-trigger="load" hx-swap="innerHTML">
			<div class="text-sm text-gray-500">Loading artwork...</div>
		</div>
		<div data-testid="indexer-releases">
			<div class="flex flex-wrap items-center justify-between gap-3 mb-3">
				<h2 class="text-lg font-semibold">Indexer releases</h2>
				<div class="flex flex-wrap gap-2">
					<a
						href={ templ.SafeURL(fmt.Sprintf("/media/%s/item/%s", moduleID, item.GetId())) }
						class="rounded-lg border border-gray-700 px-3 py-1.5 text-sm text-gray-300 hover:bg-gray-800"
					>Refresh</a>
					<form method="POST" action={ templ.SafeURL(itemDispatchAction(moduleID, item.GetId())) } class="inline">
						<input type="hidden" name="title" value={ item.GetTitle() }/>
						<input type="hidden" name="item_type" value={ automationItemTypeForTemplate(moduleID, displayName) }/>
						if item.GetMetadata()["tmdb_id"] != "" {
							<input type="hidden" name="tmdb_id" value={ item.GetMetadata()["tmdb_id"] }/>
						}
						if item.GetYear() > 0 {
							<input type="hidden" name="year" value={ strconv.FormatInt(item.GetYear(), 10) }/>
						}
						<button type="submit" name="mode" value="best" class="rounded-lg bg-indigo-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-indigo-500">Search &amp; grab best</button>
					</form>
					<form method="POST" action={ templ.SafeURL(itemDispatchAction(moduleID, item.GetId())) } class="inline">
						<input type="hidden" name="title" value={ item.GetTitle() }/>
						<input type="hidden" name="item_type" value={ automationItemTypeForTemplate(moduleID, displayName) }/>
						if item.GetMetadata()["tmdb_id"] != "" {
							<input type="hidden" name="tmdb_id" value={ item.GetMetadata()["tmdb_id"] }/>
						}
						if item.GetYear() > 0 {
							<input type="hidden" name="year" value={ strconv.FormatInt(item.GetYear(), 10) }/>
						}
						<button type="submit" name="fixture" value="1" class="rounded-lg bg-gray-700 px-3 py-1.5 text-sm font-medium text-white hover:bg-gray-600" title="Dispatch fixture magnet (offline)">Fixture</button>
					</form>
				</div>
			</div>
			if len(releases) == 0 {
				<div class="rounded-xl border border-gray-800 bg-gray-900/50 p-6 text-center text-sm text-gray-500">No indexer results. Try Refresh or Search &amp; grab best.</div>
			} else {
				<div class="overflow-x-auto rounded-xl border border-gray-800">
					<table class="min-w-full divide-y divide-gray-800 text-sm">
						<thead class="bg-gray-900/50">
							<tr>
								<th class="px-4 py-2 text-left text-xs text-gray-500">Title</th>
								<th class="px-4 py-2 text-left text-xs text-gray-500">Indexer</th>
								<th class="px-4 py-2 text-left text-xs text-gray-500">Size</th>
								<th class="px-4 py-2 text-left text-xs text-gray-500">Seeders</th>
								<th class="px-4 py-2 text-left text-xs text-gray-500">Quality</th>
								<th class="px-4 py-2 text-left text-xs text-gray-500">Approved</th>
								<th class="px-4 py-2 text-right text-xs text-gray-500">Actions</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-gray-800">
							for _, rel := range releases {
								<tr class="hover:bg-gray-900/40">
									<td class="px-4 py-2 text-gray-200 max-w-[20rem] truncate" title={ rel.GetTitle() }>{ rel.GetTitle() }</td>
									<td class="px-4 py-2 text-gray-400">{ rel.GetIndexer() }</td>
									<td class="px-4 py-2 text-gray-400 whitespace-nowrap">{ formatBytes(rel.GetSize()) }</td>
									<td class="px-4 py-2 text-gray-400">{ strconv.Itoa(int(rel.GetSeeders())) }</td>
									<td class="px-4 py-2 text-gray-400">{ rel.GetQuality() }</td>
									<td class="px-4 py-2 text-xs">
										if rel.GetApproved() {
											<span class="text-green-400">yes</span>
										} else {
											<span class="text-yellow-400">no</span>
										}
									</td>
									<td class="px-4 py-2 text-right whitespace-nowrap">
										<form method="POST" action={ templ.SafeURL(itemDispatchAction(moduleID, item.GetId())) } class="inline">
											<input type="hidden" name="title" value={ item.GetTitle() }/>
											<input type="hidden" name="item_type" value={ automationItemTypeForTemplate(moduleID, displayName) }/>
											if item.GetMetadata()["tmdb_id"] != "" {
												<input type="hidden" name="tmdb_id" value={ item.GetMetadata()["tmdb_id"] }/>
											}
											if item.GetYear() > 0 {
												<input type="hidden" name="year" value={ strconv.FormatInt(item.GetYear(), 10) }/>
											}
											<input type="hidden" name="guid" value={ rel.GetGuid() }/>
											<input type="hidden" name="release_title" value={ rel.GetTitle() }/>
											<input type="hidden" name="download_url" value={ rel.GetDownloadUrl() }/>
											<input type="hidden" name="indexer" value={ rel.GetIndexer() }/>
											<input type="hidden" name="size" value={ strconv.FormatInt(rel.GetSize(), 10) }/>
											<button type="submit" class="rounded bg-indigo-600 px-2 py-1 text-xs text-white hover:bg-indigo-500">Grab</button>
										</form>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>
		@ItemHistorySection(history)
	</div>
}

templ ArtworkGrid(artwork []*mediaadminv1.ArtworkInfo) {
	if len(artwork) > 0 {
		<div>
			<h2 class="text-lg font-semibold mb-3">Artwork</h2>
			<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
				for _, a := range artwork {
					<div class="rounded-xl border border-gray-800 bg-gray-900/50 p-2">
						<img
							src={ templ.SafeURL(a.GetUrl()) }
							alt={ a.GetType() }
							class="rounded-lg w-full"
							loading="lazy"
						/>
						<p class="text-xs text-gray-500 mt-1 text-center">{ a.GetType() }</p>
					</div>
				}
			</div>
		</div>
	}
}
