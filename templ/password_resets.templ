package templates

import "fmt"

type PasswordResetRow struct {
	ID        string
	Username  string
	Note      string
	CreatedAt string
	UserID    string
}

type PasswordResetsPageData struct {
	Rows      []PasswordResetRow
	Error     string
	SoftEmpty bool
	Message   string
}

templ PasswordResetsPage(data PasswordResetsPageData) {
	<div class="space-y-6" data-testid="password-resets-page">
		<div>
			<h1 class="text-2xl font-bold">Password reset queue</h1>
			<p class="text-gray-400 text-sm mt-1">
				Pending requests from consumer /forgot-password. Set a new password when the account is known, or dismiss stale rows.
			</p>
		</div>
		if data.Error != "" {
			<div class="rounded-xl border border-red-900/50 bg-red-950/20 p-4 text-sm text-red-300" role="alert" data-testid="password-resets-error">{ data.Error }</div>
		}
		if data.Message != "" {
			<div class="rounded-xl border border-indigo-900/40 bg-indigo-950/20 p-4 text-sm text-indigo-200" role="status" data-testid="password-resets-message">{ data.Message }</div>
		}
		if data.SoftEmpty && data.Error == "" {
			<div class="rounded-xl border border-gray-800 bg-gray-900/50 p-4 text-sm text-gray-400" role="status" data-testid="password-resets-empty">
				No pending password reset requests.
			</div>
		}
		if !data.SoftEmpty && data.Error == "" {
			<section class="rounded-xl border border-amber-900/40 bg-amber-950/10 overflow-hidden" data-testid="password-resets-list" aria-labelledby="password-resets-list-heading">
				<h2 id="password-resets-list-heading" class="sr-only">Pending password reset requests</h2>
				<ul class="divide-y divide-amber-900/40">
					for _, row := range data.Rows {
						<li class="px-4 py-3 space-y-3" data-testid="password-reset-row">
							<div class="flex flex-wrap items-start justify-between gap-3">
								<div>
									<div class="font-medium text-gray-200">{ row.Username }</div>
									if row.Note != "" {
										<div class="text-sm text-gray-400 mt-0.5">{ row.Note }</div>
									}
									if row.CreatedAt != "" {
										<div class="text-xs text-gray-500 mt-1">{ row.CreatedAt }</div>
									}
								</div>
								<form method="post" action={ templ.SafeURL("/password-resets/" + row.ID + "/dismiss") }>
									<button
										type="submit"
										class="rounded-lg border border-gray-700 px-3 py-1.5 text-xs text-gray-300 hover:bg-gray-800 transition-colors"
										data-testid="password-reset-dismiss"
										aria-label={ fmt.Sprintf("Dismiss reset request for %s", row.Username) }
									>Dismiss</button>
								</form>
							</div>
							if row.UserID != "" {
								<form
									method="post"
									action={ templ.SafeURL("/password-resets/" + row.ID + "/password") }
									class="flex flex-wrap items-end gap-2"
									data-testid="password-reset-set-password"
								>
									<div class="flex-1 min-w-[12rem]">
										<label for={ "reset-password-" + row.ID } class="block text-xs text-gray-500 mb-1">New password for { row.Username }</label>
										<input
											id={ "reset-password-" + row.ID }
											type="password"
											name="password"
											required
											autocomplete="new-password"
											class="w-full rounded-lg border border-gray-700 bg-gray-800 px-3 py-2 text-sm text-white"
										/>
									</div>
									<button
										type="submit"
										class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-500 transition-colors"
									>Set password</button>
								</form>
							} else {
								<p class="text-xs text-amber-300/90" data-testid="password-reset-no-user">
									No matching user account — create the user first or dismiss this request.
								</p>
							}
						</li>
					}
				</ul>
			</section>
		}
	</div>
}
