package templates

import "fmt"

type MarketplaceTrustKey struct {
	ID          string
	Label       string
	Fingerprint string
	Filename    string
	AddedAt     string
}

type MarketplaceTrustData struct {
	RequireSignaturePref bool
	RequireSignatureEnv  bool
	PublicKeyEnv         string
	TrustedKeysDirEnv    string
	AllowedPublishersEnv string
	AllowedPublishers    string
	TrustDir             string
	KeysDir              string
	EnvFile              string
	Keys                 []MarketplaceTrustKey
	Saved                bool
	Error                string
}

templ MarketplaceTrustPage(data MarketplaceTrustData) {
	<div class="space-y-6 max-w-4xl" data-testid="marketplace-trust-page">
		<div class="flex flex-wrap items-end justify-between gap-3">
			<div>
				<h1 class="text-2xl font-bold">Marketplace trust</h1>
				<p class="text-gray-400 text-sm mt-1">
					Distribute ed25519 / minisign public keys for DeployTag signature verification.
				</p>
			</div>
			<a href="/marketplace" class="text-sm text-indigo-400 hover:text-indigo-300">← Marketplace</a>
		</div>
		if data.Error != "" {
			<div class="rounded-xl border border-red-900/50 bg-red-950/30 px-4 py-3 text-sm text-red-200" data-testid="marketplace-trust-error">{ data.Error }</div>
		}
		if data.Saved {
			<div class="rounded-xl border border-emerald-900/40 bg-emerald-950/20 px-4 py-3 text-sm text-emerald-200" data-testid="marketplace-trust-saved">Saved. Restart core (or source the env file) so verification picks up changes.</div>
		}
		<div class="rounded-xl border border-gray-800 bg-gray-900/50 p-4 space-y-2 text-sm" data-testid="marketplace-trust-status">
			<div class="font-medium text-gray-200">Signature requirement</div>
			<p class="text-gray-400">
				This process env
				if data.RequireSignatureEnv {
					<span class="text-emerald-400 font-medium" data-testid="sig-require-on">MUXCORE_SPOOL_REQUIRE_SIGNATURE=1 (on)</span>
				} else {
					<span class="text-amber-400 font-medium" data-testid="sig-require-off">not set / off</span>
				}
			</p>
			<p class="text-xs text-gray-500 font-mono break-all">
				MUXCORE_SPOOL_PUBLIC_KEY={ emptyDash(data.PublicKeyEnv) }
			</p>
			<p class="text-xs text-gray-500 font-mono break-all">
				MUXCORE_SPOOL_TRUSTED_KEYS_DIR={ emptyDash(data.TrustedKeysDirEnv) }
			</p>
			<p class="text-xs text-gray-500 font-mono break-all">
				MUXCORE_SPOOL_ALLOWED_PUBLISHERS={ emptyDash(data.AllowedPublishersEnv) }
			</p>
			<p class="text-xs text-gray-500 mt-2">
				Admin store: <code class="text-gray-400">{ data.TrustDir }</code> · keys → <code class="text-gray-400">{ data.KeysDir }</code>
				· core env snippet: <code class="text-gray-400">{ data.EnvFile }</code>
			</p>
		</div>
		<form method="POST" action="/marketplace/trust/settings" class="rounded-xl border border-gray-800 bg-gray-900/50 p-4 space-y-4" data-testid="marketplace-trust-settings">
			<label class="flex items-center gap-2 text-sm text-gray-300">
				<input type="checkbox" name="require_signature" value="1" checked?={ data.RequireSignaturePref } class="rounded border-gray-600"/>
				Prefer require signatures (writes MUXCORE_SPOOL_REQUIRE_SIGNATURE into env snippet)
			</label>
			<label class="block space-y-1 text-sm">
				<span class="text-gray-400">Allowed publishers (comma-separated; empty = unrestricted)</span>
				<input name="allowed_publishers" value={ data.AllowedPublishers } placeholder="MuxCore, PartnerOrg" class="w-full rounded-lg border border-gray-700 bg-gray-950 px-3 py-2 text-sm font-mono"/>
			</label>
			<button type="submit" class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-500">Save trust settings</button>
		</form>
		<form method="POST" action="/marketplace/trust/keys" class="rounded-xl border border-gray-800 bg-gray-900/50 p-4 space-y-4" data-testid="marketplace-trust-add-key">
			<div class="font-medium text-gray-200">Add trusted public key</div>
			<label class="block space-y-1 text-sm">
				<span class="text-gray-400">Label (optional)</span>
				<input name="label" placeholder="release-signing" class="w-full rounded-lg border border-gray-700 bg-gray-950 px-3 py-2 text-sm"/>
			</label>
			<label class="block space-y-1 text-sm">
				<span class="text-gray-400">Public key (ed25519 raw hex/base64, PEM, or minisign .pub)</span>
				<textarea name="public_key" rows="5" required placeholder="hex, base64, PEM, or minisign public key text" class="w-full rounded-lg border border-gray-700 bg-gray-950 px-3 py-2 text-sm font-mono"></textarea>
			</label>
			<button type="submit" class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-500">Trust key</button>
		</form>
		<div class="rounded-xl border border-gray-800 bg-gray-900/40 overflow-hidden" data-testid="marketplace-trust-keys">
			<div class="px-4 py-3 border-b border-gray-800 text-sm font-medium text-gray-200">Trusted keys</div>
			if len(data.Keys) == 0 {
				<div class="px-4 py-4 text-sm text-gray-500">No trusted keys yet.</div>
			} else {
				<ul class="divide-y divide-gray-800">
					for _, key := range data.Keys {
						<li class="px-4 py-3 flex flex-wrap items-center justify-between gap-3 text-sm">
							<div class="min-w-0">
								<div class="text-gray-100 font-medium">{ key.Label }</div>
								<div class="text-xs font-mono text-gray-500 mt-0.5">fp={ key.Fingerprint } · { key.Filename }</div>
								if key.AddedAt != "" {
									<div class="text-xs text-gray-600 mt-0.5">{ key.AddedAt }</div>
								}
							</div>
							<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/marketplace/trust/keys/%s/revoke", key.ID)) } onsubmit="return confirm('Revoke this trusted key?');">
								<button type="submit" class="rounded-md border border-red-900/60 text-red-300 hover:bg-red-950/40 text-xs px-2.5 py-1.5" data-testid="marketplace-trust-revoke">Revoke</button>
							</form>
						</li>
					}
				</ul>
			}
		</div>
	</div>
}
