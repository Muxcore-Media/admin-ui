package templates

import (
	"fmt"
	"strings"
)

type ModuleDetail struct {
	ID             string
	Name           string
	Version        string
	State          string
	Healthy        bool
	HealthError    string
	Description    string
	Author         string
	Repository     string
	Roles          []string
	Capabilities   []string
	DependsOn      []string
	HTTPAddr       string
	MinCoreVersion string
}

func trustedIcon(repo string) string {
	switch {
	case repo == "internal":
		return "built-in"
	case repo != "":
		return "verified"
	default:
		return ""
	}
}

func trustedLink(repo string) string {
	switch {
	case repo == "internal":
		return "https://github.com/Muxcore-Media"
	case repo != "" && (strings.HasPrefix(repo, "https://github.com/") || strings.HasPrefix(repo, "http://github.com/")):
		return repo
	default:
		return ""
	}
}

func trustedLabel(repo string) string {
	switch {
	case repo == "internal":
		return "Built-in module"
	case repo != "":
		return "Verified — " + repo
	default:
		return "Unverified external module"
	}
}

templ ModuleDetailPage(m ModuleDetail) {
	<div class="max-w-3xl space-y-6">
		<div>
			<a href="/modules" class="text-sm text-indigo-400 hover:text-indigo-300">&larr; Back to modules</a>
		</div>

		<div class="flex items-start justify-between">
			<div>
				<div class="flex items-center gap-3">
					<h1 class="text-2xl font-bold">{ m.Name }</h1>
					@StateBadge(m.State)
					@HealthDot(m.Healthy)
				</div>
				<p class="text-sm text-gray-500 font-mono mt-1">{ m.ID }</p>
			</div>
		</div>

		@ModuleMetaFields(m)

		if m.Description != "" {
			<div>
				<h2 class="text-sm font-semibold text-gray-400 uppercase tracking-wider mb-2">Description</h2>
				<p class="text-sm text-gray-300">{ m.Description }</p>
			</div>
		}

		@ModuleRolesBlock(m.Roles)
		@ModuleCapabilitiesBlock(m.Capabilities)
		@ModuleDependenciesBlock(m.DependsOn)

		if m.HealthError != "" {
			<div class="rounded-xl border border-red-800/50 bg-red-900/20 p-4">
				<h2 class="text-sm font-semibold text-red-400 uppercase tracking-wider mb-1">Health Error</h2>
				<p class="text-sm text-red-300">{ m.HealthError }</p>
			</div>
		}
	</div>
}

templ ModuleMetaFields(m ModuleDetail) {
	<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
		@DetailField("Version", m.Version)
		if m.Author != "" {
			@DetailField("Author", m.Author)
		}
		@ModuleTrustBadge(m)
		if m.HTTPAddr != "" {
			@DetailField("HTTP Address", m.HTTPAddr)
		}
		if m.MinCoreVersion != "" {
			@DetailField("Min Core Version", m.MinCoreVersion)
		}
	</div>
}

templ ModuleTrustBadge(m ModuleDetail) {
	<div class="rounded-lg border border-gray-800 bg-gray-900/30 px-4 py-3">
		<div class="text-xs font-medium text-gray-500 uppercase tracking-wider">Trust</div>
		<div class="text-sm mt-0.5">
			if m.Repository == "internal" {
				<a href="https://github.com/Muxcore-Media" target="_blank" class="inline-flex items-center gap-1.5 text-green-400 hover:text-green-300">
					<svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
					Built-in
				</a>
			} else if m.Repository == "untrusted" {
				<span class="text-gray-500">Unverified — author claim rejected</span>
			} else if m.Repository != "" {
				<a href={ templ.SafeURL(m.Repository) } target="_blank" class="inline-flex items-center gap-1.5 text-green-400 hover:text-green-300">
					<svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
					Verified
				</a>
			} else {
				<span class="text-gray-500">Unverified</span>
			}
		</div>
	</div>
}

templ ModuleRolesBlock(roles []string) {
	<div>
		<h2 class="text-sm font-semibold text-gray-400 uppercase tracking-wider mb-2">Roles</h2>
		if len(roles) > 0 {
			<div class="flex flex-wrap gap-1.5">
				for _, r := range roles {
					@RoleTag(r)
				}
			</div>
		} else {
			<p class="text-sm text-gray-600">None</p>
		}
	</div>
}

templ ModuleCapabilitiesBlock(caps []string) {
	<div>
		<h2 class="text-sm font-semibold text-gray-400 uppercase tracking-wider mb-2">Capabilities</h2>
		if len(caps) > 0 {
			<div class="flex flex-wrap gap-1.5">
				for _, c := range caps {
					@CapabilityTag(c)
				}
			</div>
		} else {
			<p class="text-sm text-gray-600">None</p>
		}
	</div>
}

templ ModuleDependenciesBlock(deps []string) {
	<div>
		<h2 class="text-sm font-semibold text-gray-400 uppercase tracking-wider mb-2">
			{ fmt.Sprintf("Dependencies (%d)", len(deps)) }
		</h2>
		if len(deps) > 0 {
			<ul class="space-y-1">
				for _, dep := range deps {
					<li>
						<a href={ templ.SafeURL("/modules/" + dep) } class="text-sm text-indigo-400 hover:text-indigo-300 font-mono">{ dep }</a>
					</li>
				}
			</ul>
		} else {
			<p class="text-sm text-gray-600">No dependencies</p>
		}
	</div>
}

templ DetailField(label string, value string) {
	<div class="rounded-lg border border-gray-800 bg-gray-900/30 px-4 py-3">
		<div class="text-xs font-medium text-gray-500 uppercase tracking-wider">{ label }</div>
		<div class="text-sm text-gray-200 mt-0.5">{ value }</div>
	</div>
}
