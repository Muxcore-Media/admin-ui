package templates

import (
	"fmt"
	"strings"
	"time"
)

type SchedulerTask struct {
	ID        string `json:"id"`
	Name      string `json:"name"`
	CronExpr  string `json:"cron_expr"`
	Status    string `json:"status"`
	CreatedAt string `json:"created_at"`
}

templ SchedulerPage(tasks []SchedulerTask) {
	<div class="space-y-6">
		<div class="flex items-center justify-between">
			<div>
				<h1 class="text-2xl font-bold">Scheduler</h1>
				<p class="text-gray-400 text-sm mt-1">{ fmt.Sprintf("%d task(s)", len(tasks)) }</p>
			</div>
			<button
				hx-get="/scheduler/add-form"
				hx-target="#main-content"
				hx-swap="beforeend"
				class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-500 transition-colors"
			>Add Task</button>
		</div>

		@SchedulerTaskTable(tasks)
	</div>
}

templ SchedulerTaskTable(tasks []SchedulerTask) {
	<div id="scheduler-tasks" class="rounded-xl border border-gray-800 bg-gray-900/50 overflow-hidden">
		if len(tasks) == 0 {
			<div class="p-8 text-center text-sm text-gray-500">No scheduled tasks. Create one to get started.</div>
		} else {
			<table class="w-full text-sm">
				<thead>
					<tr class="border-b border-gray-800 text-left text-xs text-gray-500 uppercase tracking-wider">
						<th class="px-4 py-3 font-medium">Name</th>
						<th class="px-4 py-3 font-medium w-48">Cron Expression</th>
						<th class="px-4 py-3 font-medium w-24">Status</th>
						<th class="px-4 py-3 font-medium w-40">Created</th>
						<th class="px-4 py-3 font-medium w-20 text-right">Actions</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-gray-800/50">
					for _, t := range tasks {
						@SchedulerTaskRow(t)
					}
				</tbody>
			</table>
		}
	</div>
}

templ SchedulerTaskRow(t SchedulerTask) {
	<tr class="hover:bg-gray-800/30 transition-colors" id={ templ.SafeURL(fmt.Sprintf("task-%s", t.ID)) }>
		<td class="px-4 py-3">
			<span class="text-gray-200 font-medium">{ t.Name }</span>
		</td>
		<td class="px-4 py-3">
			<code class="text-xs text-indigo-400 font-mono bg-gray-800/50 px-2 py-0.5 rounded">{ t.CronExpr }</code>
			<span class="text-xs text-gray-600 ml-2">{ cronDescription(t.CronExpr) }</span>
		</td>
		<td class="px-4 py-3">
			<span class={ "inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium",
				templ.KV("bg-green-900/30 text-green-400 border border-green-800/50", t.Status == "scheduled"),
				templ.KV("bg-yellow-900/30 text-yellow-400 border border-yellow-800/50", t.Status == "running"),
				templ.KV("bg-gray-900/30 text-gray-400 border border-gray-800/50", t.Status == "cancelled" || t.Status == "completed"),
			}>{ t.Status }</span>
		</td>
		<td class="px-4 py-3 text-gray-400 text-xs">{ friendlyTime(t.CreatedAt) }</td>
		<td class="px-4 py-3 text-right">
			<button
				hx-delete={ templ.SafeURL(fmt.Sprintf("/scheduler/%s", t.ID)) }
				hx-target={ templ.SafeURL(fmt.Sprintf("#task-%s", t.ID)) }
				hx-swap="outerHTML"
				class="p-1 rounded text-gray-500 hover:text-red-400 hover:bg-gray-800 transition-colors"
				title="Cancel Task"
			>
				<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
			</button>
		</td>
	</tr>
}

templ AddTaskModal() {
	<div id="add-task-modal" class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center" onclick="if(event.target===this)this.remove()">
		<div class="rounded-xl border border-gray-800 bg-gray-900 p-6 w-full max-w-lg mx-4" onclick="event.stopPropagation()">
			<div class="flex items-center justify-between mb-4">
				<h2 class="text-lg font-semibold">Add Scheduled Task</h2>
				<button onclick="this.closest('#add-task-modal').remove()" class="text-gray-500 hover:text-gray-300">
					<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
				</button>
			</div>
			<form
				hx-post="/scheduler/add"
				hx-target="#scheduler-tasks"
				hx-swap="outerHTML"
				hx-on::after-request="document.getElementById('add-task-modal')?.remove()"
				class="space-y-4"
			>
				<div>
					<label class="block text-xs text-gray-500 mb-1">Task Name</label>
					<input type="text" name="name" required placeholder="e.g. nightly-backup" class="w-full rounded-lg border border-gray-700 bg-gray-800 px-3 py-2 text-sm text-white placeholder-gray-500 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"/>
				</div>
				<div>
					<label class="block text-xs text-gray-500 mb-1">Cron Expression</label>
					<input type="text" name="cron_expr" required placeholder="0 3 * * *" class="w-full rounded-lg border border-gray-700 bg-gray-800 px-3 py-2 text-sm text-white placeholder-gray-500 font-mono focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"/>
					<p class="text-xs text-gray-600 mt-1">Standard cron: minute hour dom month dow. Supports <code class="text-gray-500">{ "&#64;" }every 30m</code> and <code class="text-gray-500">{ "&#64;" }daily</code>.</p>
				</div>
				<div>
					<label class="block text-xs text-gray-500 mb-1">Timeout (optional)</label>
					<input type="text" name="timeout" placeholder="e.g. 5m, 1h" class="w-full rounded-lg border border-gray-700 bg-gray-800 px-3 py-2 text-sm text-white placeholder-gray-500 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"/>
				</div>
				<button type="submit" class="w-full rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-500 transition-colors">Create Task</button>
			</form>
		</div>
	</div>
}

func cronDescription(expr string) string {
	if strings.HasPrefix(expr, "@every ") {
		return "repeating " + expr[7:]
	}
	parts := strings.Fields(expr)
	if len(parts) < 5 {
		return ""
	}
	return fmt.Sprintf("min:%s hr:%s dom:%s mon:%s dow:%s", parts[0], parts[1], parts[2], parts[3], parts[4])
}

func friendlyTime(s string) string {
	t, err := time.Parse(time.RFC3339, s)
	if err != nil {
		return s
	}
	return t.Format("Jan 2 15:04")
}
