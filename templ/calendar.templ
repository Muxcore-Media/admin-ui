package templates

type UnifiedCalendarItem struct {
	ModuleID   string
	ModuleName string
	Kind       string
	ID         string
	ParentID   string
	Title      string
	Subtitle   string
	Date       string
	Monitored  bool
	HasFile    bool
	Season     string
	Episode    string
}

type UnifiedCalendarData struct {
	Items   []UnifiedCalendarItem
	Start   string
	End     string
	Error   string
	Warning string
}

templ UnifiedCalendarPage(data UnifiedCalendarData) {
	<div class="space-y-6" data-testid="unified-calendar-page">
		<div>
			<h1 class="text-2xl font-bold">Calendar</h1>
			<p class="text-gray-400 text-sm mt-1">Upcoming movies and TV airings across media libraries</p>
		</div>
		if data.Error != "" {
			<div class="rounded-xl border border-yellow-900/50 bg-yellow-950/20 p-4 text-sm text-yellow-300" data-testid="calendar-error">{ data.Error }</div>
		}
		if data.Warning != "" {
			<div class="rounded-xl border border-gray-700 bg-gray-900/40 p-3 text-xs text-gray-400" data-testid="calendar-warning">{ data.Warning }</div>
		}
		<form method="get" action="/calendar" class="flex flex-wrap gap-2 items-end">
			<div>
				<label class="block text-xs text-gray-500 mb-1">Start</label>
				<input type="date" name="start" value={ data.Start } class="rounded-lg border border-gray-700 bg-gray-800 px-3 py-2 text-sm"/>
			</div>
			<div>
				<label class="block text-xs text-gray-500 mb-1">End</label>
				<input type="date" name="end" value={ data.End } class="rounded-lg border border-gray-700 bg-gray-800 px-3 py-2 text-sm"/>
			</div>
			<label class="flex items-center gap-2 text-sm text-gray-400 pb-2">
				<input type="checkbox" name="unmonitored" value="1"/>
				Include unmonitored
			</label>
			<button type="submit" class="rounded-lg bg-indigo-600 px-3 py-2 text-sm font-semibold text-white hover:bg-indigo-500">Apply</button>
		</form>
		if len(data.Items) == 0 {
			<div class="rounded-xl border border-gray-800 bg-gray-900/50 p-8 text-center" data-testid="calendar-empty">
				<p class="text-gray-400">No upcoming items in this range.</p>
			</div>
		} else {
			<div class="rounded-xl border border-gray-800 overflow-hidden" data-testid="calendar-table">
				<table class="w-full text-sm">
					<thead class="bg-gray-900/80 text-gray-400 text-left">
						<tr>
							<th class="px-4 py-2 font-medium">Date</th>
							<th class="px-4 py-2 font-medium">Library</th>
							<th class="px-4 py-2 font-medium">Title</th>
							<th class="px-4 py-2 font-medium">Episode</th>
							<th class="px-4 py-2 font-medium">Status</th>
						</tr>
					</thead>
					<tbody>
						for _, it := range data.Items {
							<tr class="border-t border-gray-800">
								<td class="px-4 py-2 text-gray-400">{ it.Date }</td>
								<td class="px-4 py-2 text-gray-500 text-xs">{ it.ModuleName }</td>
								<td class="px-4 py-2">
									if it.ParentID != "" {
										<a href={ templ.SafeURL("/media/" + it.ModuleID + "/item/" + it.ParentID) } class="text-indigo-400 hover:text-indigo-300">{ it.Title }</a>
									} else {
										<span class="text-gray-200">{ it.Title }</span>
									}
								</td>
								<td class="px-4 py-2 text-gray-300">
									if it.Season != "" || it.Episode != "" {
										S{ it.Season }E{ it.Episode }
									}
									if it.Subtitle != "" {
										<span class="text-gray-500"> — { it.Subtitle }</span>
									}
								</td>
								<td class="px-4 py-2 text-gray-500">
									if it.HasFile {
										<span class="text-green-400">Has file</span>
									} else {
										<span class="text-amber-400">Missing</span>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</div>
}
