package templates

templ ErrorPage(code int, message string) {
	<div class="flex min-h-full items-center justify-center">
		<div class="text-center max-w-md">
			<div class="text-6xl font-bold text-gray-700 mb-2" aria-hidden="true">{ code }</div>
			<h1 class="text-2xl font-bold text-gray-200 mb-2">{ message }</h1>
			<p class="text-gray-500 text-sm">Error { code }</p>
		</div>
	</div>
}

templ NotFound() {
	@ErrorPage(404, "Page not found.")
}

templ Forbidden() {
	@ErrorPage(403, "You don't have permission to access this page.")
}
