package templates

import "fmt"

// ApprovalRow is a single request entry shown on the approvals admin page.
type ApprovalRow struct {
	ID          string
	ItemType    string
	Title       string
	Year        int
	Status      string
	RequestedBy string
	ApprovedBy  string
	DenyReason  string
}

// ApprovalsPageData carries all state for the approvals admin page.
type ApprovalsPageData struct {
	Pending   []ApprovalRow
	Recent    []ApprovalRow
	Message   string
	Error     string
	SoftEmpty bool
}

templ ApprovalsPage(data ApprovalsPageData) {
	<div class="space-y-6" data-testid="approvals-page">
		<div>
			<h1 class="text-2xl font-bold">Media Approval Queue</h1>
			<p class="text-gray-400 text-sm mt-1">Review pending requests and approve or deny with a reason.</p>
		</div>
		if data.Error != "" {
			<div class="rounded-xl border border-yellow-900/50 bg-yellow-950/20 p-4 text-sm text-yellow-300" role="alert" data-testid="approvals-error">{ data.Error }</div>
		}
		if data.SoftEmpty {
			<div class="rounded-xl border border-gray-800 bg-gray-900/50 p-4 text-sm text-gray-400" role="status" data-testid="approvals-soft-empty">
				request-media unavailable — set ADMIN_UI_REQUEST_MEDIA_URL or register the media.request capability.
			</div>
		}
		if data.Message != "" {
			<div class="rounded-xl border border-indigo-900/40 bg-indigo-950/20 p-4 text-sm text-indigo-200" role="status" data-testid="approvals-message">{ data.Message }</div>
		}
		if !data.SoftEmpty {
			<section class="space-y-3" data-testid="approvals-pending" aria-labelledby="approvals-pending-heading">
				<h2 id="approvals-pending-heading" class="text-lg font-semibold">
					Pending
					if len(data.Pending) > 0 {
						<span class="ml-2 rounded-full bg-amber-500/20 px-2 py-0.5 text-sm font-normal text-amber-300">{ fmt.Sprintf("%d", len(data.Pending)) }</span>
					}
				</h2>
				if len(data.Pending) == 0 {
					<p class="text-sm text-gray-500" data-testid="approvals-pending-empty">No pending requests.</p>
				} else {
					<ul class="divide-y divide-gray-800 rounded-xl border border-amber-900/40 bg-amber-950/10" data-testid="approvals-pending-list">
						for _, row := range data.Pending {
							<li class="space-y-2 px-4 py-3" data-testid="approvals-pending-item">
								<div class="flex flex-wrap items-start justify-between gap-2">
									<div>
										<span class="font-medium">{ row.Title }</span>
										<span class="ml-1 text-gray-500">({ fmt.Sprintf("%d", row.Year) })</span>
										<div class="text-xs text-gray-500 mt-0.5">{ row.ItemType } · requested by { row.RequestedBy }</div>
									</div>
									<div class="flex flex-wrap items-center gap-2">
										<form method="post" action={ templ.SafeURL("/approvals/" + row.ID + "/approve") }>
											<button
												type="submit"
												class="rounded-lg bg-emerald-700 px-3 py-1.5 text-xs font-medium text-white hover:bg-emerald-600"
												data-testid="approvals-approve"
												aria-label={ fmt.Sprintf("Approve request for %s", row.Title) }
											>Approve</button>
										</form>
										<form method="post" action={ templ.SafeURL("/approvals/" + row.ID + "/deny") } class="flex items-center gap-1.5">
											<input
												type="text"
												name="reason"
												placeholder="Deny reason (optional)"
												class="rounded-lg border border-gray-700 bg-gray-800 px-2 py-1.5 text-xs text-white placeholder-gray-500 w-44"
												aria-label={ fmt.Sprintf("Deny reason for %s", row.Title) }
											/>
											<button
												type="submit"
												class="rounded-lg border border-gray-700 bg-gray-800 px-3 py-1.5 text-xs font-medium text-white hover:border-red-500"
												data-testid="approvals-deny"
												aria-label={ fmt.Sprintf("Deny request for %s", row.Title) }
											>Deny</button>
										</form>
									</div>
								</div>
							</li>
						}
					</ul>
				}
			</section>
			<section class="space-y-3" data-testid="approvals-recent" aria-labelledby="approvals-recent-heading">
				<h2 id="approvals-recent-heading" class="text-lg font-semibold">Recent</h2>
				if len(data.Recent) == 0 {
					<p class="text-sm text-gray-500">No recent requests.</p>
				} else {
					<ul class="divide-y divide-gray-800 rounded-xl border border-gray-800" data-testid="approvals-recent-list">
						for _, row := range data.Recent {
							<li class="flex flex-wrap items-center justify-between gap-3 px-4 py-2.5 text-sm" data-testid="approvals-recent-item">
								<div>
									<span class="font-medium">{ row.Title }</span>
									<span class="ml-1 text-gray-500">({ fmt.Sprintf("%d", row.Year) })</span>
									<div class="text-xs text-gray-500 mt-0.5">{ row.ItemType } · by { row.RequestedBy }</div>
								</div>
								<div class="text-right">
									@approvalStatusBadge(row.Status)
									if row.DenyReason != "" {
										<div class="text-xs text-red-400 mt-0.5" data-testid="approvals-deny-reason">{ row.DenyReason }</div>
									}
									if row.ApprovedBy != "" {
										<div class="text-xs text-gray-500 mt-0.5">by { row.ApprovedBy }</div>
									}
								</div>
							</li>
						}
					</ul>
				}
			</section>
		}
	</div>
}

templ approvalStatusBadge(status string) {
	switch status {
	case "approved":
		<span class="rounded-full bg-emerald-500/20 px-2 py-0.5 text-xs font-medium text-emerald-300">approved</span>
	case "denied":
		<span class="rounded-full bg-red-500/20 px-2 py-0.5 text-xs font-medium text-red-300">denied</span>
	case "added":
		<span class="rounded-full bg-indigo-500/20 px-2 py-0.5 text-xs font-medium text-indigo-300">added</span>
	case "watchlisted":
		<span class="rounded-full bg-purple-500/20 px-2 py-0.5 text-xs font-medium text-purple-300">watchlisted</span>
	default:
		<span class="rounded-full bg-gray-700/60 px-2 py-0.5 text-xs font-medium text-gray-400">{ status }</span>
	}
}
