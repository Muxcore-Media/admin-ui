package templates

import "fmt"

type UnifiedQueueWanted struct {
	ID        string
	ItemID    string
	ItemType  string
	Title     string
	Year      int
	TMDBID    int
	Monitored bool
	Missing   bool
	UpdatedAt string
}

type UnifiedQueueHistory struct {
	ID           string
	WantedItemID string
	GUID         string
	Status       string
	StatusLabel  string
	StatusDetail string
	Title        string
	Source       string
	At           string
	DownloadID   string
	Warning      bool
	Stuck        bool
}

type UnifiedQueueData struct {
	Wanted      []UnifiedQueueWanted
	History     []UnifiedQueueHistory
	Failures    []UnifiedQueueHistory
	FailureCount int
	StuckCount   int
	Filter      string
	Page       int
	PageSize   int
	Total      int
	TotalPages int
	Error      string
	Flash      string
}

templ UnifiedQueuePage(data UnifiedQueueData) {
	<div
		class="space-y-6"
		data-testid="unified-queue-page"
		aria-live="polite"
		hx-get="/queue"
		hx-trigger="every 15s"
		hx-select="[data-testid='unified-queue-page']"
		hx-swap="outerHTML"
		hx-include="[name='filter']"
	>
		<div>
			<h1 class="text-2xl font-bold">Queue</h1>
			<p class="text-gray-400 text-sm mt-1">Pending downloads and recent history — retry or clear stuck items here</p>
		</div>
		if data.Flash != "" {
			<div class="rounded-xl border border-green-900/50 bg-green-950/20 p-4 text-sm text-green-300" role="status" data-testid="queue-flash">{ data.Flash }</div>
		}
		if data.Error != "" {
			<div class="rounded-xl border border-yellow-900/50 bg-yellow-950/20 p-4 text-sm text-yellow-300" role="alert" data-testid="queue-error">{ data.Error }</div>
		}
		if data.FailureCount == 0 && data.Error == "" {
			<div class="rounded-xl border border-green-900/40 bg-green-950/15 p-4 text-sm text-green-300/90" role="status" data-testid="queue-healthy">No stuck imports or failed downloads need attention.</div>
		}
		if data.FailureCount > 0 {
			<section class="space-y-3" data-testid="queue-failures-section" aria-labelledby="queue-failures-heading">
				<div class="flex flex-wrap items-center justify-between gap-2">
					<h2 id="queue-failures-heading" class="text-lg font-semibold text-amber-200">
						Needs attention
						<span class="text-sm font-normal text-amber-300/80">({ fmt.Sprintf("%d", data.FailureCount) })</span>
					</h2>
					<a href="/automation" class="text-xs text-indigo-400 hover:underline">Automation details</a>
				</div>
				<ul class="space-y-2">
					for _, h := range data.Failures {
						<li class={ "rounded-lg border px-3 py-2 text-sm", templ.KV("border-amber-800/60 bg-amber-950/20", h.Stuck), templ.KV("border-red-900/40 bg-red-950/10", h.Warning && !h.Stuck) }>
							<div class="flex flex-wrap items-center gap-2">
								<span class="text-gray-200">{ h.Title }</span>
								if h.Stuck {
									if h.StatusLabel != "" {
										<span class="rounded bg-amber-900/50 px-1.5 py-0.5 text-xs text-amber-200" data-testid="stuck-badge">{ h.StatusLabel }</span>
									} else if h.StatusDetail != "" {
										<span class="rounded bg-amber-900/50 px-1.5 py-0.5 text-xs text-amber-200" data-testid="stuck-badge">{ h.StatusDetail }</span>
									} else {
										<span class="rounded bg-amber-900/50 px-1.5 py-0.5 text-xs text-amber-200" data-testid="stuck-badge">{ h.Status }</span>
									}
								} else {
									if h.StatusLabel != "" {
										<span class="rounded bg-red-900/40 px-1.5 py-0.5 text-xs text-red-200" data-testid="warn-badge">{ h.StatusLabel }</span>
									} else if h.StatusDetail != "" {
										<span class="rounded bg-red-900/40 px-1.5 py-0.5 text-xs text-red-200" data-testid="warn-badge">{ h.StatusDetail }</span>
									} else {
										<span class="rounded bg-red-900/40 px-1.5 py-0.5 text-xs text-red-200" data-testid="warn-badge">{ h.Status }</span>
									}
								}
								if h.Source != "" {
									<span class="text-gray-600">— { h.Source }</span>
								}
								if h.At != "" {
									<span class="text-xs text-gray-600 ml-auto">{ h.At }</span>
								}
							</div>
							if h.Stuck || (h.WantedItemID != "" && h.GUID != "") || (h.Warning && !h.Stuck) {
								<div class="mt-2 flex flex-wrap gap-2">
									if h.Stuck {
										<form method="POST" action="/queue/retry-import" class="inline">
											<input type="hidden" name="history_id" value={ h.ID }/>
											<button type="submit" class="rounded bg-indigo-600 px-2 py-1 text-xs text-white hover:bg-indigo-500" data-testid="retry-import">Retry import</button>
										</form>
									}
									if h.WantedItemID != "" && h.GUID != "" {
										<form method="POST" action="/queue/blocklist" class="inline">
											<input type="hidden" name="wanted_item_id" value={ h.WantedItemID }/>
											<input type="hidden" name="guid" value={ h.GUID }/>
											<button type="submit" class="rounded border border-gray-700 px-2 py-1 text-xs text-gray-300 hover:bg-gray-800" data-testid="blocklist-release">Blocklist</button>
										</form>
									} else if h.Warning && !h.Stuck {
										<a href="/automation" class="rounded border border-gray-700 px-2 py-1 text-xs text-gray-300 hover:bg-gray-800" data-testid="automation-details-link">Automation details</a>
									}
								</div>
							}
						</li>
					}
				</ul>
			</section>
		}
		<form class="flex flex-wrap gap-3 items-end" method="get" action="/queue" aria-label="Filter queue">
			<div>
				<label for="queue-filter" class="block text-xs font-medium text-gray-500 mb-1">Filter</label>
				<select id="queue-filter" name="filter" class="rounded-lg border border-gray-700 bg-gray-800 px-3 py-2 text-sm text-white">
					<option value="" selected?={ data.Filter == "" }>All</option>
					<option value="movie" selected?={ data.Filter == "movie" }>Movies</option>
					<option value="tv" selected?={ data.Filter == "tv" }>TV</option>
				</select>
			</div>
			<button type="submit" class="rounded-lg bg-indigo-600 px-3 py-2 text-sm font-medium text-white hover:bg-indigo-500">Apply</button>
		</form>
		if data.StuckCount > 0 {
			<form method="POST" action="/queue/retry-import" class="inline">
				<button type="submit" class="rounded-lg border border-gray-700 px-3 py-2 text-sm text-gray-300 hover:bg-gray-800" title="Retry all import_failed">Retry imports</button>
			</form>
		}
		<section aria-labelledby="queue-wanted-heading">
			<h2 id="queue-wanted-heading" class="text-lg font-semibold mb-3">Wanted <span class="text-sm font-normal text-gray-500">({ fmt.Sprintf("%d", data.Total) })</span></h2>
			if len(data.Wanted) == 0 {
				if data.FailureCount == 0 && data.Error == "" {
					<div class="rounded-xl border border-green-900/30 bg-green-950/10 p-6 text-center text-sm" data-testid="queue-wanted-empty">
						<p class="text-green-400/90">Queue healthy</p>
						<p class="mt-1 text-gray-500">No pending wanted items.</p>
					</div>
				} else {
					<div class="rounded-xl border border-gray-800 bg-gray-900/50 p-6 text-center text-sm text-gray-500" data-testid="queue-wanted-empty">Queue is empty.</div>
				}
			} else {
				<div class="overflow-x-auto rounded-xl border border-gray-800" data-testid="queue-wanted-table">
					<table class="min-w-full divide-y divide-gray-800 text-sm">
						<caption class="sr-only">Wanted queue items</caption>
						<thead class="bg-gray-900/50">
							<tr>
								<th scope="col" class="px-4 py-2 text-left text-xs text-gray-500">Title</th>
								<th scope="col" class="px-4 py-2 text-left text-xs text-gray-500">Type</th>
								<th scope="col" class="px-4 py-2 text-left text-xs text-gray-500">Flags</th>
								<th scope="col" class="px-4 py-2 text-right text-xs text-gray-500">Actions</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-gray-800">
							for _, it := range data.Wanted {
								<tr class="hover:bg-gray-900/40">
									<td class="px-4 py-2 text-gray-200">
										{ it.Title }
										if it.Year > 0 {
											<span class="text-gray-500">({ fmt.Sprintf("%d", it.Year) })</span>
										}
									</td>
									<td class="px-4 py-2 text-gray-400">{ it.ItemType }</td>
									<td class="px-4 py-2 text-xs text-gray-400">
										if it.Missing {
											<span class="text-yellow-400" data-testid="wanted-missing">missing</span>
										}
										if it.Monitored {
											<span class="text-green-400 ml-1">monitored</span>
										}
									</td>
									<td class="px-4 py-2 text-right whitespace-nowrap">
										<form method="POST" action="/queue/remove" class="inline">
											<input type="hidden" name="queue_id" value={ it.ID }/>
											<button type="submit" class="rounded border border-red-900/50 px-2 py-1 text-xs text-red-300 hover:bg-red-950/30" data-testid="queue-remove" aria-label={ fmt.Sprintf("Remove %s from queue", it.Title) }>Remove</button>
										</form>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</section>
		<section aria-labelledby="queue-history-heading">
			<h2 id="queue-history-heading" class="text-lg font-semibold mb-3">Download history</h2>
			if len(data.History) == 0 {
				<div class="rounded-xl border border-gray-800 bg-gray-900/50 p-6 text-center text-sm text-gray-500" data-testid="queue-history-empty">No download history yet.</div>
			} else {
				<ul class="space-y-2" data-testid="queue-history-list">
					for _, h := range data.History {
						<li class={ "rounded-lg border px-3 py-2 text-sm", templ.KV("border-amber-800/60 bg-amber-950/20", h.Stuck), templ.KV("border-red-900/40 bg-red-950/10", h.Warning && !h.Stuck), templ.KV("border-gray-800 bg-gray-900/40", !h.Warning) }>
							<div class="flex flex-wrap items-center gap-2">
								<span class="text-gray-200">{ h.Title }</span>
								if h.Stuck {
									if h.StatusLabel != "" {
										<span class="rounded bg-amber-900/50 px-1.5 py-0.5 text-xs text-amber-200" data-testid="stuck-badge">{ h.StatusLabel }</span>
									} else if h.StatusDetail != "" {
										<span class="rounded bg-amber-900/50 px-1.5 py-0.5 text-xs text-amber-200" data-testid="stuck-badge">{ h.StatusDetail }</span>
									} else {
										<span class="rounded bg-amber-900/50 px-1.5 py-0.5 text-xs text-amber-200" data-testid="stuck-badge">{ h.Status }</span>
									}
								} else if h.Warning {
									if h.StatusLabel != "" {
										<span class="rounded bg-red-900/40 px-1.5 py-0.5 text-xs text-red-200" data-testid="warn-badge">{ h.StatusLabel }</span>
									} else if h.StatusDetail != "" {
										<span class="rounded bg-red-900/40 px-1.5 py-0.5 text-xs text-red-200" data-testid="warn-badge">{ h.StatusDetail }</span>
									} else {
										<span class="rounded bg-red-900/40 px-1.5 py-0.5 text-xs text-red-200" data-testid="warn-badge">{ h.Status }</span>
									}
								} else {
									<span class="text-gray-500">· { h.Status }</span>
								}
								if h.Source != "" {
									<span class="text-gray-600">— { h.Source }</span>
								}
								if h.At != "" {
									<span class="text-xs text-gray-600 ml-auto">{ h.At }</span>
								}
							</div>
							if h.Stuck || (h.WantedItemID != "" && h.GUID != "") || (h.Warning && !h.Stuck) {
								<div class="mt-2 flex flex-wrap gap-2">
									if h.Stuck {
										<form method="POST" action="/queue/retry-import" class="inline">
											<input type="hidden" name="history_id" value={ h.ID }/>
											<button type="submit" class="rounded bg-indigo-600 px-2 py-1 text-xs text-white hover:bg-indigo-500" data-testid="retry-import">Retry import</button>
										</form>
									}
									if h.WantedItemID != "" && h.GUID != "" {
										<form method="POST" action="/queue/blocklist" class="inline">
											<input type="hidden" name="wanted_item_id" value={ h.WantedItemID }/>
											<input type="hidden" name="guid" value={ h.GUID }/>
											<button type="submit" class="rounded border border-gray-700 px-2 py-1 text-xs text-gray-300 hover:bg-gray-800" data-testid="blocklist-release">Blocklist</button>
										</form>
									} else if h.Warning && !h.Stuck {
										<a href="/automation" class="rounded border border-gray-700 px-2 py-1 text-xs text-gray-300 hover:bg-gray-800" data-testid="automation-details-link">Automation details</a>
									}
								</div>
							}
						</li>
					}
				</ul>
			}
		</section>
		<p class="text-xs text-gray-600">Full automation controls also live on <a href="/automation" class="text-indigo-400 hover:underline">Automation</a>.</p>
	</div>
}
