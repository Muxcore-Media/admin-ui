package templates

import "fmt"

type ListSyncSourceRow struct {
	ID           string
	Name         string
	Type         string
	Enabled      bool
	Username     string
	ListURL      string
	IntervalMin  int
	LastSynced   string
	BaseURL      string
}

type ListSyncHistoryRow struct {
	ID          string
	SourceName  string
	Status      string
	ItemsFound  int
	ItemsNew    int
	Error       string
	StartedAt   string
	CompletedAt string
}

type ListSyncPageData struct {
	Sources []ListSyncSourceRow
	Flash   string
	Error   string
}

type ListSyncHistoryPageData struct {
	Entries []ListSyncHistoryRow
	Total   int
	Error   string
}

templ ListSyncPage(data ListSyncPageData) {
	<div class="space-y-6" data-testid="list-sync-page">
		<div class="flex flex-wrap items-start justify-between gap-3">
			<div>
				<h1 class="text-2xl font-bold">List Sync</h1>
				<p class="text-gray-400 text-sm mt-1">Import lists from Trakt, IMDb, Plex, Jellyfin, Radarr, Sonarr</p>
			</div>
			<div class="flex gap-2">
				<a href="/list-sync/history" class="rounded-lg border border-gray-700 px-3 py-2 text-sm text-gray-300 hover:bg-gray-800">History</a>
				<form method="POST" action="/list-sync/sync">
					<button type="submit" class="rounded-lg bg-indigo-600 px-3 py-2 text-sm font-medium text-white hover:bg-indigo-500" data-testid="list-sync-now">
						Sync now
					</button>
				</form>
			</div>
		</div>

		if data.Flash != "" {
			<div class="rounded-xl border border-green-900/50 bg-green-950/20 p-4 text-sm text-green-300" data-testid="list-sync-flash">{ data.Flash }</div>
		}
		if data.Error != "" {
			<div class="rounded-xl border border-yellow-900/50 bg-yellow-950/20 p-4 text-sm text-yellow-300">{ data.Error }</div>
		}

		<div>
			<h2 class="text-lg font-semibold mb-3">Sources</h2>
			if len(data.Sources) == 0 {
				<div class="rounded-xl border border-gray-800 bg-gray-900/50 p-6 text-center text-sm text-gray-500">No sources configured.</div>
			} else {
				<div class="overflow-x-auto rounded-xl border border-gray-800">
					<table class="min-w-full divide-y divide-gray-800 text-sm">
						<thead class="bg-gray-900/50">
							<tr>
								<th class="px-4 py-2 text-left text-xs text-gray-500">Name</th>
								<th class="px-4 py-2 text-left text-xs text-gray-500">Type</th>
								<th class="px-4 py-2 text-left text-xs text-gray-500">Interval</th>
								<th class="px-4 py-2 text-left text-xs text-gray-500">Last synced</th>
								<th class="px-4 py-2 text-left text-xs text-gray-500"></th>
							</tr>
						</thead>
						<tbody class="divide-y divide-gray-800">
							for _, s := range data.Sources {
								<tr>
									<td class="px-4 py-2">
										<div class="font-medium text-white">{ s.Name }</div>
										if s.ListURL != "" {
											<div class="text-xs text-gray-500 truncate max-w-xs">{ s.ListURL }</div>
										} else if s.Username != "" {
											<div class="text-xs text-gray-500">{ s.Username }</div>
										}
									</td>
									<td class="px-4 py-2 text-gray-300">{ s.Type }</td>
									<td class="px-4 py-2 text-gray-400">{ fmt.Sprintf("%dm", s.IntervalMin) }</td>
									<td class="px-4 py-2 text-gray-400">
										if s.LastSynced != "" {
											{ s.LastSynced }
										} else {
											<span class="text-gray-600">never</span>
										}
									</td>
									<td class="px-4 py-2 text-right">
										<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/list-sync/sources/%s/delete", s.ID)) }>
											<button type="submit" class="text-xs text-red-400 hover:text-red-300">Remove</button>
										</form>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>

		<div class="max-w-xl">
			<h2 class="text-lg font-semibold mb-3">Add source</h2>
			<form method="POST" action="/list-sync/sources" class="space-y-3 rounded-xl border border-gray-800 bg-gray-900/50 p-4">
				<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
					<div>
						<label class="block text-xs text-gray-500 mb-1">Name</label>
						<input type="text" name="name" required class="w-full rounded-lg border border-gray-700 bg-gray-800 px-3 py-2 text-sm"/>
					</div>
					<div>
						<label class="block text-xs text-gray-500 mb-1">Type</label>
						<select name="type" required class="w-full rounded-lg border border-gray-700 bg-gray-800 px-3 py-2 text-sm">
							<option value="trakt">trakt</option>
							<option value="imdb">imdb</option>
							<option value="plex">plex</option>
							<option value="jellyfin">jellyfin</option>
							<option value="radarr">radarr</option>
							<option value="sonarr">sonarr</option>
						</select>
					</div>
					<div>
						<label class="block text-xs text-gray-500 mb-1">Username</label>
						<input type="text" name="username" class="w-full rounded-lg border border-gray-700 bg-gray-800 px-3 py-2 text-sm"/>
					</div>
					<div>
						<label class="block text-xs text-gray-500 mb-1">Client ID</label>
						<input type="text" name="client_id" class="w-full rounded-lg border border-gray-700 bg-gray-800 px-3 py-2 text-sm"/>
					</div>
					<div class="sm:col-span-2">
						<label class="block text-xs text-gray-500 mb-1">List URL / playlist id</label>
						<input type="text" name="list_url" class="w-full rounded-lg border border-gray-700 bg-gray-800 px-3 py-2 text-sm"/>
					</div>
					<div>
						<label class="block text-xs text-gray-500 mb-1">Base URL</label>
						<input type="text" name="base_url" class="w-full rounded-lg border border-gray-700 bg-gray-800 px-3 py-2 text-sm"/>
					</div>
					<div>
						<label class="block text-xs text-gray-500 mb-1">API key / token</label>
						<input type="password" name="api_key" class="w-full rounded-lg border border-gray-700 bg-gray-800 px-3 py-2 text-sm"/>
					</div>
					<div>
						<label class="block text-xs text-gray-500 mb-1">Sync interval (minutes)</label>
						<input type="number" name="sync_interval_minutes" value="60" min="1" class="w-full rounded-lg border border-gray-700 bg-gray-800 px-3 py-2 text-sm"/>
					</div>
					<div>
						<label class="block text-xs text-gray-500 mb-1">Quality profile ID</label>
						<input type="text" name="quality_profile_id" class="w-full rounded-lg border border-gray-700 bg-gray-800 px-3 py-2 text-sm"/>
					</div>
					<div class="sm:col-span-2">
						<label class="block text-xs text-gray-500 mb-1">Root folder path</label>
						<input type="text" name="root_folder_path" class="w-full rounded-lg border border-gray-700 bg-gray-800 px-3 py-2 text-sm"/>
					</div>
				</div>
				<button type="submit" class="rounded-lg bg-indigo-600 px-3 py-2 text-sm font-medium text-white hover:bg-indigo-500">Add source</button>
			</form>
		</div>
	</div>
}

templ ListSyncHistoryPage(data ListSyncHistoryPageData) {
	<div class="space-y-6" data-testid="list-sync-history-page">
		<div>
			<a href="/list-sync" class="text-sm text-indigo-400 hover:text-indigo-300">&larr; List Sync</a>
			<h1 class="text-2xl font-bold mt-2">Sync history</h1>
			<p class="text-gray-400 text-sm mt-1">Recent list-sync runs</p>
		</div>

		if data.Error != "" {
			<div class="rounded-xl border border-yellow-900/50 bg-yellow-950/20 p-4 text-sm text-yellow-300">{ data.Error }</div>
		}

		if len(data.Entries) == 0 && data.Error == "" {
			<div class="rounded-xl border border-gray-800 bg-gray-900/50 p-6 text-center text-sm text-gray-500">No sync history yet.</div>
		} else if len(data.Entries) > 0 {
			<p class="text-xs text-gray-500">Showing { fmt.Sprintf("%d", len(data.Entries)) } of { fmt.Sprintf("%d", data.Total) }</p>
			<div class="overflow-x-auto rounded-xl border border-gray-800">
				<table class="min-w-full divide-y divide-gray-800 text-sm">
					<thead class="bg-gray-900/50">
						<tr>
							<th class="px-4 py-2 text-left text-xs text-gray-500">Source</th>
							<th class="px-4 py-2 text-left text-xs text-gray-500">Status</th>
							<th class="px-4 py-2 text-left text-xs text-gray-500">Found</th>
							<th class="px-4 py-2 text-left text-xs text-gray-500">New</th>
							<th class="px-4 py-2 text-left text-xs text-gray-500">Started</th>
							<th class="px-4 py-2 text-left text-xs text-gray-500">Error</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-gray-800">
						for _, e := range data.Entries {
							<tr>
								<td class="px-4 py-2 text-white">{ e.SourceName }</td>
								<td class="px-4 py-2 text-gray-300">{ e.Status }</td>
								<td class="px-4 py-2 text-gray-400">{ fmt.Sprintf("%d", e.ItemsFound) }</td>
								<td class="px-4 py-2 text-gray-400">{ fmt.Sprintf("%d", e.ItemsNew) }</td>
								<td class="px-4 py-2 text-gray-400">{ e.StartedAt }</td>
								<td class="px-4 py-2 text-red-400 text-xs max-w-xs truncate">{ e.Error }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</div>
}
