package templates

import "fmt"

// FailedDownloadRow is a stuck or warning download-history record from the
// automation service, shaped for the failed-downloads control-plane table.
type FailedDownloadRow struct {
	ID           string
	WantedItemID string
	GUID         string
	Title        string
	Status       string
	StatusLabel  string
	StatusDetail string
	Source       string
	At           string
	Stuck        bool
	Warning      bool
}

type FailedDownloadsPageData struct {
	Rows     []FailedDownloadRow
	SoftNote bool
	Flash    string
	Error    string
}

templ FailedDownloadsPage(data FailedDownloadsPageData) {
	<div
		class="space-y-6"
		data-testid="failed-downloads-page"
		aria-live="polite"
		hx-get="/failed-downloads"
		hx-trigger="every 15s"
		hx-select="[data-testid='failed-downloads-page']"
		hx-swap="outerHTML"
	>
		<div class="flex flex-wrap items-start justify-between gap-3">
			<div>
				<h1 class="text-2xl font-bold">Failed downloads</h1>
				<p class="text-gray-400 text-sm mt-1">Recent failed or stuck grabs — dismiss or retry without SSH.</p>
			</div>
			<a href="/queue" class="text-sm text-indigo-400 hover:underline">Full queue view</a>
		</div>
		if data.Flash != "" {
			<div class="rounded-xl border border-green-900/50 bg-green-950/20 p-4 text-sm text-green-300" role="status" data-testid="failed-downloads-flash">{ data.Flash }</div>
		}
		if data.Error != "" {
			<div class="rounded-xl border border-yellow-900/50 bg-yellow-950/20 p-4 text-sm text-yellow-300" role="alert" data-testid="failed-downloads-error">{ data.Error }</div>
		}
		if data.SoftNote {
			<div class="rounded-xl border border-gray-800 bg-gray-900/50 px-4 py-3 text-sm text-gray-400" data-testid="failed-downloads-soft-empty">
				media.automation not registered — deploy the automation module to triage failed downloads.
			</div>
		}
		@FailedDownloadsTable(data.Rows, data.SoftNote)
	</div>
}

templ FailedDownloadsTable(rows []FailedDownloadRow, softNote bool) {
	if len(rows) == 0 {
		if !softNote {
			<div class="rounded-xl border border-green-900/40 bg-green-950/15 p-6 text-center text-sm" role="status" data-testid="failed-downloads-empty">
				<p class="text-green-400/90">No failed or stuck downloads</p>
				<p class="mt-1 text-gray-500">Grab and import failures will appear here when they need attention.</p>
			</div>
		}
	} else {
		<section class="overflow-x-auto rounded-xl border border-gray-800" aria-labelledby="failed-downloads-table-heading" data-testid="failed-downloads-table">
			<h2 id="failed-downloads-table-heading" class="sr-only">Failed and stuck downloads</h2>
			<table class="min-w-full divide-y divide-gray-800 text-sm">
				<caption class="sr-only">Failed and stuck downloads ({ fmt.Sprintf("%d", len(rows)) })</caption>
				<thead class="bg-gray-900/50">
					<tr>
						<th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Title</th>
						<th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Indexer / client</th>
						<th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
						<th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Age</th>
						<th scope="col" class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-gray-800">
					for _, row := range rows {
						<tr
							class={ "hover:bg-gray-900/40", templ.KV("bg-amber-950/10", row.Stuck), templ.KV("bg-red-950/5", row.Warning && !row.Stuck) }
							data-testid="failed-downloads-row"
						>
							<td class="px-4 py-3 text-gray-200">
								<div class="flex flex-col gap-1">
									<span>{ row.Title }</span>
									if row.WantedItemID != "" {
										<a
											href="/queue"
											class="text-xs text-indigo-400 hover:text-indigo-300"
											data-testid="failed-downloads-wanted-link"
										>Wanted queue item</a>
									}
								</div>
							</td>
							<td class="px-4 py-3 text-gray-400 whitespace-nowrap">
								if row.Source != "" {
									{ row.Source }
								} else {
									<span class="text-gray-600">—</span>
								}
							</td>
							<td class="px-4 py-3">
								@failedDownloadStatusBadge(row)
								if row.StatusDetail != "" && row.StatusDetail != row.StatusLabel {
									<p class="mt-1 text-xs text-gray-500 max-w-md truncate" title={ row.StatusDetail }>{ row.StatusDetail }</p>
								}
							</td>
							<td class="px-4 py-3 text-gray-500 whitespace-nowrap font-mono text-xs">{ row.At }</td>
							<td class="px-4 py-3 text-right whitespace-nowrap">
								<div class="flex flex-wrap justify-end gap-2">
									if row.Stuck {
										<form method="POST" action="/failed-downloads/retry" class="inline">
											<input type="hidden" name="history_id" value={ row.ID }/>
											<button type="submit" class="rounded bg-indigo-600 px-2 py-1 text-xs text-white hover:bg-indigo-500" data-testid="failed-downloads-retry">Retry import</button>
										</form>
									}
									if row.WantedItemID != "" && row.GUID != "" {
										<form method="POST" action="/failed-downloads/dismiss" class="inline">
											<input type="hidden" name="wanted_item_id" value={ row.WantedItemID }/>
											<input type="hidden" name="guid" value={ row.GUID }/>
											<button type="submit" class="rounded border border-gray-700 px-2 py-1 text-xs text-gray-300 hover:bg-gray-800" data-testid="failed-downloads-dismiss">Dismiss</button>
										</form>
									}
								</div>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</section>
	}
}

templ failedDownloadStatusBadge(row FailedDownloadRow) {
	if row.Stuck {
		if row.StatusLabel != "" {
			<span class="rounded bg-amber-900/50 px-1.5 py-0.5 text-xs text-amber-200" data-testid="failed-downloads-stuck-badge">{ row.StatusLabel }</span>
		} else if row.StatusDetail != "" {
			<span class="rounded bg-amber-900/50 px-1.5 py-0.5 text-xs text-amber-200" data-testid="failed-downloads-stuck-badge">{ row.StatusDetail }</span>
		} else {
			<span class="rounded bg-amber-900/50 px-1.5 py-0.5 text-xs text-amber-200" data-testid="failed-downloads-stuck-badge">{ row.Status }</span>
		}
	} else {
		if row.StatusLabel != "" {
			<span class="rounded bg-red-900/40 px-1.5 py-0.5 text-xs text-red-200" data-testid="failed-downloads-warn-badge">{ row.StatusLabel }</span>
		} else if row.StatusDetail != "" {
			<span class="rounded bg-red-900/40 px-1.5 py-0.5 text-xs text-red-200" data-testid="failed-downloads-warn-badge">{ row.StatusDetail }</span>
		} else {
			<span class="rounded bg-red-900/40 px-1.5 py-0.5 text-xs text-red-200" data-testid="failed-downloads-warn-badge">{ row.Status }</span>
		}
	}
}
