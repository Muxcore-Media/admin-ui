package templates

import (
	"fmt"
	"strings"
)

// FailedImportEntry is a stuck or warning download-history record from the
// automation service.  The IDs come from that service and are used directly
// by the retry / dismiss action endpoints.
type FailedImportEntry struct {
	ID           string
	WantedItemID string
	GUID         string
	Title        string
	Status       string
	StatusLabel  string
	StatusDetail string
	Source       string
	At           string
	Stuck        bool
	Warning      bool
}

type ActivityEntry struct {
	ID          string
	EventType   string
	ItemID      string
	Title       string
	SourceTitle string
	Quality     string
	Indexer     string
	FilePath    string
	CreatedAt   string
	ModuleID    string
	ModuleName  string
}

type ActivityPageData struct {
	Entries       []ActivityEntry
	FailedImports []FailedImportEntry
	EventType     string
	Page          int
	TotalPages    int
	Total         int
	UpstreamDown  bool
	Flash         string
	Error         string
}

templ ActivityPage(data ActivityPageData) {
	<div class="space-y-6" data-testid="activity-page">
		<div>
			<h1 class="text-2xl font-bold">Activity</h1>
			<p class="text-gray-400 text-sm mt-1">Grab, import, and delete history across media libraries</p>
		</div>
		if data.Flash != "" {
			<div class="rounded-xl border border-green-900/50 bg-green-950/20 p-4 text-sm text-green-300" role="status" data-testid="activity-flash">{ data.Flash }</div>
		}
		if data.Error != "" {
			<div class="rounded-xl border border-yellow-900/50 bg-yellow-950/20 p-4 text-sm text-yellow-300" role="alert" data-testid="activity-error">{ data.Error }</div>
		}
		if data.UpstreamDown {
			<div class="rounded-xl border border-yellow-900/50 bg-yellow-950/20 p-6 text-sm" role="alert" data-testid="activity-upstream-down">
				<p class="font-medium text-yellow-300">Media libraries unavailable</p>
				<p class="mt-1 text-yellow-300/70">Could not reach any media module. Activity history will appear once modules are back online.</p>
			</div>
		}
		if len(data.FailedImports) > 0 {
			@FailedImportsSection(data.FailedImports)
		}
		<section aria-labelledby="activity-filter-heading">
			<h2 id="activity-filter-heading" class="sr-only">Activity filter</h2>
			<form
				class="flex flex-wrap gap-3 items-end"
				hx-get="/activity"
				hx-target="main"
				hx-push-url="true"
				hx-trigger="submit"
			>
				<div>
					<label for="activity-event-type" class="block text-xs font-medium text-gray-500 mb-1">Event type</label>
					<select
						id="activity-event-type"
						name="event_type"
						class="rounded-lg border border-gray-700 bg-gray-800 px-3 py-2 text-sm text-white focus:border-indigo-500 focus:outline-none"
					>
						<option value="" selected?={ data.EventType == "" }>All</option>
						<option value="grab" selected?={ data.EventType == "grab" }>Grab</option>
						<option value="import" selected?={ data.EventType == "import" }>Import</option>
						<option value="delete_item" selected?={ data.EventType == "delete_item" }>Delete item</option>
						<option value="delete_file" selected?={ data.EventType == "delete_file" }>Delete file</option>
					</select>
				</div>
				<button
					type="submit"
					class="rounded-lg bg-indigo-600 px-3 py-2 text-sm font-medium text-white hover:bg-indigo-500 transition-colors"
				>Filter</button>
			</form>
		</section>
		@ActivityTable(data.Entries)
		if data.TotalPages > 1 {
			@Pagination(data.Page, data.TotalPages, "/activity")
		}
	</div>
}

// FailedImportsSection renders the "Needs attention" triage panel.
templ FailedImportsSection(items []FailedImportEntry) {
	<section class="space-y-3" data-testid="activity-failures-section" aria-labelledby="activity-failures-heading">
		<div class="flex flex-wrap items-center justify-between gap-2">
			<h2 id="activity-failures-heading" class="text-lg font-semibold text-amber-200">
				Failed imports
				<span class="text-sm font-normal text-amber-300/80" data-testid="activity-failure-count">({ fmt.Sprintf("%d", len(items)) })</span>
			</h2>
			<a href="/queue" class="text-xs text-indigo-400 hover:underline">Full queue view</a>
		</div>
		<ul class="space-y-2">
			for _, entry := range items {
				<li
					class={ "rounded-lg border px-3 py-2 text-sm", templ.KV("border-amber-800/60 bg-amber-950/20", entry.Stuck), templ.KV("border-red-900/40 bg-red-950/10", entry.Warning && !entry.Stuck) }
					data-testid="activity-failure-row"
				>
					<div class="flex flex-wrap items-center gap-2">
						<span class="text-gray-200">{ entry.Title }</span>
						if entry.Stuck {
							if entry.StatusLabel != "" {
								<span class="rounded bg-amber-900/50 px-1.5 py-0.5 text-xs text-amber-200" data-testid="activity-stuck-badge">{ entry.StatusLabel }</span>
							} else if entry.StatusDetail != "" {
								<span class="rounded bg-amber-900/50 px-1.5 py-0.5 text-xs text-amber-200" data-testid="activity-stuck-badge">{ entry.StatusDetail }</span>
							} else {
								<span class="rounded bg-amber-900/50 px-1.5 py-0.5 text-xs text-amber-200" data-testid="activity-stuck-badge">{ entry.Status }</span>
							}
						} else {
							if entry.StatusLabel != "" {
								<span class="rounded bg-red-900/40 px-1.5 py-0.5 text-xs text-red-200" data-testid="activity-warn-badge">{ entry.StatusLabel }</span>
							} else if entry.StatusDetail != "" {
								<span class="rounded bg-red-900/40 px-1.5 py-0.5 text-xs text-red-200" data-testid="activity-warn-badge">{ entry.StatusDetail }</span>
							} else {
								<span class="rounded bg-red-900/40 px-1.5 py-0.5 text-xs text-red-200" data-testid="activity-warn-badge">{ entry.Status }</span>
							}
						}
						if entry.Source != "" {
							<span class="text-gray-600">— { entry.Source }</span>
						}
						if entry.At != "" {
							<span class="text-xs text-gray-600 ml-auto">{ entry.At }</span>
						}
					</div>
					<div class="mt-2 flex flex-wrap gap-2">
						if entry.Stuck {
							<form method="POST" action="/activity/retry" class="inline">
								<input type="hidden" name="history_id" value={ entry.ID }/>
								<button type="submit" class="rounded bg-indigo-600 px-2 py-1 text-xs text-white hover:bg-indigo-500" data-testid="activity-retry">Retry import</button>
							</form>
						}
						if entry.WantedItemID != "" && entry.GUID != "" {
							<form method="POST" action="/activity/dismiss" class="inline">
								<input type="hidden" name="wanted_item_id" value={ entry.WantedItemID }/>
								<input type="hidden" name="guid" value={ entry.GUID }/>
								<button type="submit" class="rounded border border-gray-700 px-2 py-1 text-xs text-gray-300 hover:bg-gray-800" data-testid="activity-dismiss">Dismiss</button>
							</form>
						}
					</div>
				</li>
			}
		</ul>
	</section>
}

templ ActivityTable(entries []ActivityEntry) {
	if len(entries) == 0 {
		<div class="rounded-xl border border-gray-800 bg-gray-900/50 p-6 text-center text-sm text-gray-500" role="status" data-testid="activity-empty">
			No activity yet.
		</div>
	} else {
		<section class="overflow-x-auto rounded-xl border border-gray-800" aria-labelledby="activity-table-heading">
			<h2 id="activity-table-heading" class="sr-only">Activity history</h2>
			<table class="min-w-full divide-y divide-gray-800 text-sm">
				<caption class="sr-only">Activity history</caption>
				<thead class="bg-gray-900/50">
					<tr>
						<th scope="col" class="px-3 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Time</th>
						<th scope="col" class="px-3 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Library</th>
						<th scope="col" class="px-3 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Event</th>
						<th scope="col" class="px-3 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Title</th>
						<th scope="col" class="px-3 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Source</th>
						<th scope="col" class="px-3 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Details</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-gray-800 text-xs">
					for _, e := range entries {
						<tr class="hover:bg-gray-800/30 transition-colors">
							<td class="px-3 py-2.5 whitespace-nowrap text-gray-400 font-mono">{ e.CreatedAt }</td>
							<td class="px-3 py-2.5 whitespace-nowrap text-gray-300">{ e.ModuleName }</td>
							<td class="px-3 py-2.5 whitespace-nowrap">
								@activityEventBadge(e.EventType)
							</td>
							<td class="px-3 py-2.5 whitespace-nowrap">
								if e.ModuleID != "" && e.ItemID != "" {
									<a
										href={ templ.SafeURL(fmt.Sprintf("/media/%s/item/%s", e.ModuleID, e.ItemID)) }
										class="text-indigo-400 hover:text-indigo-300"
										aria-label={ fmt.Sprintf("Open %s", e.Title) }
										data-testid="activity-open-item"
									>{ e.Title }</a>
								} else {
									<span class="text-gray-200">{ e.Title }</span>
								}
							</td>
							<td class="px-3 py-2.5 text-gray-400 max-w-[220px] truncate" title={ e.SourceTitle }>{ e.SourceTitle }</td>
							<td class="px-3 py-2.5 text-gray-500 max-w-[240px] truncate" title={ activityDetails(e) }>{ activityDetails(e) }</td>
						</tr>
					}
				</tbody>
			</table>
		</section>
	}
}

templ ItemHistorySection(entries []ActivityEntry) {
	<div class="space-y-3">
		<h2 class="text-lg font-semibold">History</h2>
		@ActivityTable(entries)
	</div>
}

templ activityEventBadge(eventType string) {
	switch eventType {
		case "import_failed":
			<span class="rounded-md bg-red-900/30 px-1.5 py-0.5 text-xs font-medium text-red-300 border border-red-800/50">{ eventType }</span>
		case "grab":
			<span class="rounded-md bg-indigo-900/30 px-1.5 py-0.5 text-xs font-medium text-indigo-400 border border-indigo-800/50">{ eventType }</span>
		default:
			<span class="rounded-md bg-gray-800/50 px-1.5 py-0.5 text-xs font-medium text-gray-400 border border-gray-700/50">{ eventType }</span>
	}
}

func activityDetails(e ActivityEntry) string {
	parts := make([]string, 0, 3)
	if e.Quality != "" {
		parts = append(parts, e.Quality)
	}
	if e.Indexer != "" {
		parts = append(parts, e.Indexer)
	}
	if e.FilePath != "" {
		parts = append(parts, e.FilePath)
	}
	return strings.Join(parts, " · ")
}
