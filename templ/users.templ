package templates

import (
	"fmt"
	"strings"

	authv1 "github.com/Muxcore-Media/core/proto/gen/muxcore/auth/v1"
)

func rolesDisplay(roles []string) string {
	if len(roles) == 0 {
		return "—"
	}
	return strings.Join(roles, ", ")
}

func totpBadge(enabled bool) string {
	if enabled {
		return "On"
	}
	return "Off"
}

templ UsersPage(users []*authv1.UserInfo, errorMsg string, pendingResetCount int) {
	<div class="space-y-6" data-testid="users-page">
		<div class="flex items-center justify-between">
			<div>
				<h1 class="text-2xl font-bold">Users</h1>
				<p class="text-gray-400 text-sm mt-1">Manage users, roles, and authentication</p>
			</div>
			<button
				type="button"
				hx-get="/users/create-form"
				hx-target="#create-form"
				hx-swap="innerHTML"
				aria-controls="create-form"
				class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-500 transition-colors"
			>Add User</button>
		</div>
		if errorMsg != "" {
			<div class="rounded-xl border border-red-900/50 bg-red-950/20 p-4 text-sm text-red-300" role="alert" data-testid="users-error">{ errorMsg }</div>
		}
		if pendingResetCount > 0 {
			<div class="rounded-xl border border-amber-800/40 bg-amber-950/20 p-4 text-sm" data-testid="password-reset-banner">
				<a href="/password-resets" class="text-amber-200 hover:text-amber-100 font-medium">
					{ fmt.Sprintf("%d pending password reset request(s)", pendingResetCount) }
				</a>
				<span class="text-gray-500 ml-2">— review on the password reset queue</span>
			</div>
		}
		<div id="create-form"></div>
		<section class="rounded-xl border border-gray-800 overflow-hidden" aria-labelledby="users-table-heading">
			<h2 id="users-table-heading" class="sr-only">Registered users</h2>
			<table class="w-full text-sm">
				<caption class="sr-only">Registered users</caption>
				<thead>
					<tr class="border-b border-gray-800 bg-gray-900/50">
						<th scope="col" class="text-left px-4 py-3 text-xs font-medium text-gray-500 uppercase tracking-wider">Username</th>
						<th scope="col" class="text-left px-4 py-3 text-xs font-medium text-gray-500 uppercase tracking-wider">Roles</th>
						<th scope="col" class="text-left px-4 py-3 text-xs font-medium text-gray-500 uppercase tracking-wider">TOTP</th>
						<th scope="col" class="text-right px-4 py-3 text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-gray-800">
					if users == nil || len(users) == 0 {
						<tr>
							<td colspan="4" class="px-4 py-8 text-center text-gray-500">
								if errorMsg != "" {
									User list unavailable.
								} else {
									No users found. Add one above.
								}
							</td>
						</tr>
					} else {
						for _, u := range users {
							<tr class="hover:bg-gray-900/30 transition-colors">
								<td class="px-4 py-3">
									<div class="font-medium text-gray-200">{ u.GetUsername() }</div>
									<div class="text-xs text-gray-500">{ u.GetId() }</div>
								</td>
								<td class="px-4 py-3 text-gray-400">{ rolesDisplay(u.GetRoles()) }</td>
								<td class="px-4 py-3">
									@TOTPBadge(u.GetTotpEnabled())
								</td>
								<td class="px-4 py-3 text-right">
									<button
										type="button"
										hx-get={ templ.SafeURL(fmt.Sprintf("/users/%s/detail", u.GetId())) }
										hx-target="#user-detail"
										hx-swap="innerHTML"
										aria-controls="user-detail"
										aria-label={ fmt.Sprintf("Manage user %s", u.GetUsername()) }
										class="text-xs text-indigo-400 hover:text-indigo-300 mr-3"
									>Manage</button>
									<button
										type="button"
										hx-delete={ templ.SafeURL(fmt.Sprintf("/users/%s", u.GetId())) }
										hx-confirm={ fmt.Sprintf("Delete user %q?", u.GetUsername()) }
										hx-target="body"
										hx-swap="innerHTML"
										aria-label={ fmt.Sprintf("Delete user %s", u.GetUsername()) }
										class="text-xs text-red-400 hover:text-red-300"
									>Delete</button>
								</td>
							</tr>
						}
					}
				</tbody>
			</table>
		</section>
		<div id="user-detail"></div>
	</div>
}

templ UserCreateForm() {
	<div class="rounded-xl border border-gray-800 bg-gray-900/50 p-4 mb-4">
		<h3 id="user-create-heading" class="text-sm font-semibold text-gray-200 mb-3">New User</h3>
		<form
			hx-post="/users"
			hx-target="body"
			hx-swap="innerHTML"
			class="space-y-3 max-w-md"
			aria-labelledby="user-create-heading"
		>
			<div>
				<label for="user-create-username" class="block text-xs text-gray-500 mb-1">Username</label>
				<input
					id="user-create-username"
					type="text"
					name="username"
					required
					autocomplete="username"
					class="w-full rounded-lg border border-gray-700 bg-gray-800 px-3 py-2 text-sm text-white"
				/>
			</div>
			<div>
				<label for="user-create-password" class="block text-xs text-gray-500 mb-1">Password</label>
				<input
					id="user-create-password"
					type="password"
					name="password"
					required
					autocomplete="new-password"
					class="w-full rounded-lg border border-gray-700 bg-gray-800 px-3 py-2 text-sm text-white"
				/>
			</div>
			<button
				type="submit"
				class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-500 transition-colors"
			>Create</button>
		</form>
	</div>
}

templ UserDetailPage(user *authv1.UserInfo) {
	<div class="rounded-xl border border-gray-800 bg-gray-900/50 p-4 mt-4">
		<h3 class="text-sm font-semibold text-gray-200 mb-3">Manage: { user.GetUsername() }</h3>
		<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
			<div class="space-y-4">
				<div>
					<h4 class="text-xs font-medium text-gray-500 uppercase tracking-wider mb-2">Password</h4>
					<form
						hx-post={ templ.SafeURL(fmt.Sprintf("/users/%s/password", user.GetId())) }
						hx-target="body"
						hx-swap="innerHTML"
						class="flex gap-2"
					>
						<input
							type="password"
							name="password"
							placeholder="New password"
							required
							class="flex-1 rounded-lg border border-gray-700 bg-gray-800 px-3 py-2 text-sm text-white"
						/>
						<button
							type="submit"
							class="rounded-lg bg-gray-700 px-4 py-2 text-sm text-gray-200 hover:bg-gray-600 transition-colors"
						>Set</button>
					</form>
				</div>
				<div>
					<h4 class="text-xs font-medium text-gray-500 uppercase tracking-wider mb-2">Roles</h4>
					<form
						hx-post={ templ.SafeURL(fmt.Sprintf("/users/%s/roles", user.GetId())) }
						hx-target="body"
						hx-swap="innerHTML"
						class="space-y-2"
					>
						@RoleCheckbox(user.GetRoles(), "admin", "Admin")
						@RoleCheckbox(user.GetRoles(), "manager", "Manager")
						@RoleCheckbox(user.GetRoles(), "user", "User")
						@RoleCheckbox(user.GetRoles(), "viewer", "Viewer")
						<button
							type="submit"
							class="rounded-lg bg-gray-700 px-4 py-2 text-sm text-gray-200 hover:bg-gray-600 transition-colors mt-2"
						>Save Roles</button>
					</form>
				</div>
			</div>
			<div class="space-y-4">
				<div>
					<h4 class="text-xs font-medium text-gray-500 uppercase tracking-wider mb-2">TOTP</h4>
					<div
						data-totp-panel
						hx-get={ templ.SafeURL(fmt.Sprintf("/users/%s/totp", user.GetId())) }
						hx-trigger="load"
						hx-swap="innerHTML"
						class="text-sm"
					>
						<span class="text-gray-500">Loading...</span>
					</div>
				</div>
				<div>
					<h4 class="text-xs font-medium text-gray-500 uppercase tracking-wider mb-2">Passkeys</h4>
					<div
						id={ fmt.Sprintf("passkeys-%s", user.GetId()) }
						data-passkey-list
						hx-get={ templ.SafeURL(fmt.Sprintf("/users/%s/passkeys", user.GetId())) }
						hx-trigger="load"
						hx-swap="innerHTML"
					>
						<span class="text-xs text-gray-500">Loading...</span>
					</div>
				</div>
				<div>
					<h4 class="text-xs font-medium text-gray-500 uppercase tracking-wider mb-2">API Tokens</h4>
					<div
						hx-get={ templ.SafeURL(fmt.Sprintf("/users/%s/tokens", user.GetId())) }
						hx-trigger="load"
						hx-swap="innerHTML"
					>
						<span class="text-xs text-gray-500">Loading...</span>
					</div>
				</div>
				<div
					hx-get={ templ.SafeURL(fmt.Sprintf("/users/%s/parental", user.GetId())) }
					hx-trigger="load"
					hx-swap="innerHTML"
				>
					<span class="text-xs text-gray-500">Loading parental…</span>
				</div>
			</div>
		</div>
	</div>
}

templ RoleCheckbox(currentRoles []string, role, label string) {
	<label class="flex items-center gap-2 cursor-pointer">
		<input
			type="checkbox"
			name="roles"
			value={ role }
			if containsRole(currentRoles, role) {
				checked
			}
			class="rounded border-gray-600 bg-gray-800 text-indigo-600 focus:ring-indigo-500"
		/>
		<span class="text-sm text-gray-300">{ label }</span>
	</label>
}

templ TOTPBadge(enabled bool) {
	if enabled {
		<span class="inline-flex items-center gap-1 rounded-full bg-green-900/30 px-2 py-0.5 text-xs font-medium text-green-400 border border-green-800/50" aria-label="TOTP enabled">
			<span class="w-1.5 h-1.5 rounded-full bg-green-400" aria-hidden="true"></span>
			On
		</span>
	} else {
		<span class="inline-flex items-center gap-1 rounded-full bg-gray-800 px-2 py-0.5 text-xs font-medium text-gray-400 border border-gray-700" aria-label="TOTP disabled">
			Off
		</span>
	}
}

func containsRole(roles []string, role string) bool {
	for _, r := range roles {
		if r == role {
			return true
		}
	}
	return false
}

templ PasskeyList(credentials []*authv1.WebAuthnCredentialInfo, count int, userID string) {
	<div class="space-y-2">
		if count == 0 {
			<p class="text-xs text-gray-500">No passkeys registered.</p>
		} else {
			for _, pk := range credentials {
				<div class="flex items-center justify-between text-sm">
					<div>
						<span class="text-gray-300">Passkey</span>
						<span class="text-gray-500 text-xs ml-2">{ pk.GetCreatedAt() }</span>
					</div>
					<button
						hx-delete={ templ.SafeURL(fmt.Sprintf("/users/%s/passkeys/%s", userID, pk.GetId())) }
						hx-confirm="Delete this passkey?"
						hx-target="body"
						hx-swap="innerHTML"
						class="text-xs text-red-400 hover:text-red-300"
					>Remove</button>
				</div>
			}
		}
		<div class="mt-2">
			<button
				hx-get={ templ.SafeURL(fmt.Sprintf("/api/auth/passkey/register/%s/begin", userID)) }
				hx-target={ templ.SafeURL(fmt.Sprintf("#passkey-register-%s", userID)) }
				hx-swap="innerHTML"
				class="text-xs text-indigo-400 hover:text-indigo-300"
			>Register Passkey</button>
			<div id={ fmt.Sprintf("passkey-register-%s", userID) }></div>
		</div>
	</div>
}

templ PasskeyRegisterContainer(optionsJSON string, userID, challenge string) {
	<div
		data-webauthn-options={ optionsJSON }
		data-webauthn-complete-url={ templ.SafeURL(fmt.Sprintf("/api/auth/passkey/register/%s/complete?challenge=%s", userID, challenge)) }
		data-webauthn-error=""
	>
		<p class="text-xs text-yellow-400 mb-1">Follow your browser's passkey prompt to register.</p>
		<p class="text-xs text-gray-500">If nothing happens, your browser may not support passkeys.</p>
	</div>
	<script>htmx.trigger(document.body, 'webauthn:register')</script>
}

templ PasskeyStatusPanel(totpEnabled bool, userID string) {
	<div class="space-y-2">
		<div class="flex items-center justify-between">
			<span class="text-xs text-gray-400">TOTP</span>
			@TOTPBadge(totpEnabled)
		</div>
	</div>
}

templ UserTokens(tokens []*authv1.APITokenInfo, userID string) {
	<div class="space-y-2">
		if len(tokens) > 0 {
			for _, t := range tokens {
				<div class="flex items-center justify-between text-sm">
					<div>
						<span class="text-gray-300">{ t.GetName() }</span>
						<span class="text-gray-500 ml-2">{ t.GetPrefix() }...</span>
					</div>
					<button
						hx-delete={ templ.SafeURL(fmt.Sprintf("/users/%s/tokens/%s", userID, t.GetId())) }
						hx-confirm="Delete this token?"
						hx-target="body"
						hx-swap="innerHTML"
						class="text-xs text-red-400 hover:text-red-300"
					>Revoke</button>
				</div>
			}
		} else {
			<p class="text-xs text-gray-500">No API tokens.</p>
		}
		<div class="mt-2">
			<form
				hx-post={ templ.SafeURL(fmt.Sprintf("/users/%s/tokens", userID)) }
				hx-target="body"
				hx-swap="innerHTML"
				class="flex gap-2"
			>
				<input
					type="text"
					name="name"
					placeholder="Token name"
					required
					class="flex-1 rounded-lg border border-gray-700 bg-gray-800 px-3 py-1.5 text-xs text-white"
				/>
				<button
					type="submit"
					class="rounded-lg bg-gray-700 px-3 py-1.5 text-xs text-gray-200 hover:bg-gray-600 transition-colors"
				>Create</button>
			</form>
		</div>
	</div>
}

// Loading the status also establishes support before exposing a mutation.
templ UserTOTPControls(enabled bool, userID string) {
	<div class="space-y-2">
		if enabled {
			<p class="text-xs text-green-400">TOTP is enabled</p>
		} else {
			<p class="text-xs text-gray-400">TOTP is disabled</p>
		}
		<button type="button" hx-post={ templ.SafeURL(fmt.Sprintf("/users/%s/totp", userID)) } hx-target="closest [data-totp-panel]" hx-swap="innerHTML" class="text-xs text-indigo-400 hover:text-indigo-300 mt-2">Toggle TOTP</button>
	</div>
}
