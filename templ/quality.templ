package templates

import (
	"strconv"
)

templ QualityProfilesPage(defs []QualityDefinition, profiles []QualityProfile) {
	<div class="space-y-8 max-w-4xl">
		<div>
			<h1 class="text-2xl font-bold">Quality Profiles</h1>
			<p class="text-gray-400 text-sm mt-1">Manage quality definitions and upgrade profiles</p>
		</div>

		<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
			@QualityDefinitionsPanel(defs)
			@QualityProfilesList(profiles, defs)
		</div>

		@QualityProfileForm(nil, defs)
	</div>
}

templ QualityDefinitionsPanel(defs []QualityDefinition) {
	<div class="rounded-xl border border-gray-800 bg-gray-900/50">
		<div class="px-5 py-4 border-b border-gray-800">
			<h2 class="text-lg font-semibold">Quality Definitions</h2>
		</div>
		<div class="p-5 space-y-3">
			for _, d := range defs {
				<form
					hx-post={ templ.SafeURL("/quality-profiles/defs/" + d.ID) }
					hx-target="closest form"
					hx-swap="outerHTML"
					class="rounded-lg border border-gray-800 bg-gray-900/30 p-3"
				>
					<div class="flex items-center gap-3">
						<input type="text" name="name" value={ d.Name } class="flex-1 rounded border border-gray-700 bg-gray-800 px-2 py-1 text-xs text-white"/>
						<div class="flex items-center gap-1">
							<input type="number" name="resolution" value={ strconv.Itoa(d.Resolution) } class="w-16 rounded border border-gray-700 bg-gray-800 px-2 py-1 text-xs text-white text-right"/>
							<span class="text-xs text-gray-500">p</span>
						</div>
						<label class="flex items-center gap-1 text-xs text-gray-400 cursor-pointer">
							<input type="checkbox" name="allowed" if d.Allowed { checked } class="rounded border-gray-700 bg-gray-800 text-indigo-600"/>
							Allowed
						</label>
						<button type="submit" class="rounded bg-indigo-600 px-2 py-1 text-xs text-white hover:bg-indigo-500">Save</button>
					</div>
				</form>
			}
		</div>
	</div>
}

templ QualityProfilesList(profiles []QualityProfile, defs []QualityDefinition) {
	<div class="rounded-xl border border-gray-800 bg-gray-900/50">
		<div class="px-5 py-4 border-b border-gray-800">
			<h2 class="text-lg font-semibold">Profiles</h2>
		</div>
		<div class="p-5 space-y-3">
			for _, p := range profiles {
				@QualityProfileCard(p, defs)
			}
			if len(profiles) == 0 {
				<p class="text-sm text-gray-500 text-center py-4">No profiles configured. Create one below.</p>
			}
		</div>
	</div>
}

templ QualityProfileCard(p QualityProfile, defs []QualityDefinition) {
	<div class="rounded-lg border border-gray-800 bg-gray-900/30 p-4" id={ templ.SafeURL("profile-" + p.ID) }>
		<div class="flex items-center justify-between mb-2">
			<h3 class="text-sm font-semibold text-gray-200">{ p.Name }</h3>
			if p.ID != "default" {
				<button
					hx-delete={ templ.SafeURL("/quality-profiles/" + p.ID) }
					hx-target={ templ.SafeURL("#profile-" + p.ID) }
					hx-swap="outerHTML"
					class="text-red-400 hover:text-red-300 text-xs"
				>Delete</button>
			}
		</div>
		<div class="flex flex-wrap gap-1 mb-2">
			for _, qid := range p.QualityIDs {
				@QualityTag(qid, defs)
			}
		</div>
		<div class="text-xs text-gray-500">
			<span>Upgrade: { boolLabel(p.UpgradeAllowed) }</span>
			if p.UpgradeAllowed && p.CutoffQuality != "" {
				<span class="ml-3">Cutoff: { qualityName(p.CutoffQuality, defs) }</span>
			}
		</div>
		<button
			hx-get={ templ.SafeURL("/quality-profiles/" + p.ID + "/edit") }
			hx-target="#profile-form-container"
			hx-swap="innerHTML"
			class="mt-2 text-xs text-indigo-400 hover:text-indigo-300"
		>Edit</button>
	</div>
}

templ QualityProfileForm(edit *QualityProfile, defs []QualityDefinition) {
	<div id="profile-form-container" class="rounded-xl border border-gray-800 bg-gray-900/50">
		<div class="px-5 py-4 border-b border-gray-800">
			<h2 class="text-lg font-semibold">
				if edit != nil {
					<span>Edit Profile</span>
				} else {
					<span>New Profile</span>
				}
			</h2>
		</div>
		<form
			action={ templ.SafeURL(profileFormAction(edit)) }
			method="POST"
			class="p-5 space-y-4"
		>
			if edit != nil {
				<input type="hidden" name="id" value={ edit.ID }/>
			}
			<div>
				<label class="block text-xs text-gray-500 mb-1">Profile Name</label>
				<input type="text" name="name" value={ profileNameValue(edit) } required placeholder="e.g. HD 1080p" class="w-full rounded-lg border border-gray-700 bg-gray-800 px-3 py-2 text-sm text-white"/>
			</div>
			<div>
				<label class="block text-xs text-gray-500 mb-1">Qualities</label>
				<div class="grid grid-cols-2 gap-2">
					for _, d := range defs {
						<label class="flex items-center gap-2 text-sm text-gray-300 cursor-pointer">
							<input
								type="checkbox" name="quality_ids" value={ d.ID }
								if edit != nil && qualityInSlice(d.ID, edit.QualityIDs) {
									checked
								}
								class="rounded border-gray-700 bg-gray-800 text-indigo-600"
							/>
							{ d.Name }
						</label>
					}
				</div>
			</div>
			<label class="flex items-center gap-2">
				<input type="checkbox" name="upgrade_allowed" if edit != nil && edit.UpgradeAllowed { checked } class="rounded border-gray-700 bg-gray-800 text-indigo-600"/>
				<span class="text-sm text-gray-300">Allow automatic upgrades</span>
			</label>
			<div id="cutoff-field" class={ templ.KV("hidden", edit == nil || !edit.UpgradeAllowed) }>
				<label class="block text-xs text-gray-500 mb-1">Cutoff Quality</label>
				<select name="cutoff_quality" class="w-full rounded-lg border border-gray-700 bg-gray-800 px-3 py-2 text-sm text-white">
					<option value="">No cutoff</option>
					for _, d := range defs {
						<option value={ d.ID } if edit != nil && edit.CutoffQuality == d.ID { selected }>{ d.Name }</option>
					}
				</select>
			</div>
			<button type="submit" class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-500 transition-colors">
				if edit != nil {
					<span>Update Profile</span>
				} else {
					<span>Create Profile</span>
				}
			</button>
		</form>
	</div>
}

templ QualityProfileEditForm(profileID string, p QualityProfile, defs []QualityDefinition) {
	@QualityProfileForm(&p, defs)
}

type QualityDefinition struct {
	ID         string
	Name       string
	Resolution int
	Allowed    bool
}

type QualityProfile struct {
	ID             string
	Name           string
	QualityIDs     []string
	UpgradeAllowed bool
	CutoffQuality  string
}

func qualityName(id string, defs []QualityDefinition) string {
	for _, d := range defs {
		if d.ID == id {
			return d.Name
		}
	}
	return id
}

templ QualityTag(id string, defs []QualityDefinition) {
	<span class={ "inline-flex items-center rounded-md px-1.5 py-0.5 text-xs font-medium border",
		templ.KV("bg-purple-900/30 text-purple-400 border-purple-800/50", id == "uhd-2160p"),
		templ.KV("bg-blue-900/30 text-blue-400 border-blue-800/50", id == "fhd-1080p"),
		templ.KV("bg-green-900/30 text-green-400 border-green-800/50", id == "hd-720p"),
		templ.KV("bg-gray-900/30 text-gray-400 border-gray-800/50", id == "sd-480p"),
	}>{ qualityName(id, defs) }</span>
}

func profileFormAction(edit *QualityProfile) string {
	if edit != nil {
		return "/quality-profiles/" + edit.ID + "/update"
	}
	return "/quality-profiles/create"
}

func profileNameValue(edit *QualityProfile) string {
	if edit != nil {
		return edit.Name
	}
	return ""
}

func qualityInSlice(id string, ids []string) bool {
	for _, i := range ids {
		if i == id {
			return true
		}
	}
	return false
}
