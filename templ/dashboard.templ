package templates

import "fmt"

type DashboardData struct {
	NodeCount         int
	LeaderID          string
	LeaderHTTPAddr    string
	LeaderGRPCAddr    string
	LeaderModuleCount int
	Disconnected      bool
}

func displayNodeID(id string) string {
	if len(id) >= 8 && id[:8] == "muxcore-" {
		id = id[8:]
	}
	if len(id) > 0 && id[0] == ':' {
		return "localhost" + id
	}
	return id
}

func nodeAvatar(id string) string {
	for _, ch := range id {
		if ch >= 'a' && ch <= 'z' {
			return string(ch - 32)
		}
		if ch >= 'A' && ch <= 'Z' {
			return string(ch)
		}
		if ch >= '0' && ch <= '9' {
			return string(ch)
		}
	}
	if len(id) > 0 {
		return id[:1]
	}
	return "N"
}

templ NoAuthPage() {
	<div class="flex min-h-full items-center justify-center">
		<div class="text-center max-w-md">
			<div class="mx-auto w-12 h-12 rounded-xl bg-yellow-600/20 border border-yellow-700/50 flex items-center justify-center text-xl mb-4">!</div>
			<h1 class="text-2xl font-bold mb-2">No Auth Provider</h1>
			<p class="text-gray-400 text-sm mb-4">
				No <code class="text-gray-300 bg-gray-800 px-1 rounded">AuthProvider</code> module is registered with core.
				The admin UI requires an auth module to handle login.
			</p>
			<p class="text-gray-500 text-xs">
				Register an auth module with core, then restart the admin UI.
			</p>
		</div>
	</div>
}

templ DashboardPage(data DashboardData) {
	if data.Disconnected {
		<div class="flex min-h-full items-center justify-center">
			<div class="text-center max-w-md">
				<div class="mx-auto w-12 h-12 rounded-xl bg-red-600/20 border border-red-700/50 flex items-center justify-center text-xl mb-4">!</div>
				<h1 class="text-2xl font-bold mb-2">Disconnected</h1>
				<p class="text-gray-400 text-sm">Could not connect to core at the configured gRPC address.</p>
			</div>
		</div>
	} else {
		<div class="space-y-6">
			<div>
				<h1 class="text-2xl font-bold">Dashboard</h1>
				<p class="text-gray-400 text-sm mt-1">System overview</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
				@ClusterStatCard("Nodes", fmt.Sprintf("%d", data.NodeCount), "Total cluster members")
				@LeaderCard(data)
				@ClusterStatCard("Version", "v0.1.0", "Core version")
			</div>

			<div>
				<h2 class="text-lg font-semibold mb-3">Module Health</h2>
				<div
					id="health-grid"
					class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4"
					hx-get="/dashboard/health"
					hx-trigger="load, every 5s"
					hx-target="this"
					hx-swap="innerHTML"
				>
					@LoadingCard()
				</div>
			</div>

			<div>
				<h2 class="text-lg font-semibold mb-3">Health Monitor</h2>
				<div
					id="monitor-summary"
					hx-get="/dashboard/monitor"
					hx-trigger="load, every 10s"
					hx-target="this"
					hx-swap="innerHTML"
				>
					@LoadingCard()
				</div>
			</div>
		</div>
	}
}

type MonitorSummaryData struct {
	Status        string
	ModuleCount   int
	StaleCount    int64
	DegradedCount int64
	EventsPublish int64
	Modules       []MonitorModuleItem
	Recent        []MonitorEventItem
}

type MonitorModuleItem struct {
	ID    string
	State string
	Stale bool
	Error string
}

type MonitorEventItem struct {
	Type     string
	ModuleID string
	Message  string
}

templ MonitorSummary(data MonitorSummaryData) {
	<div class="rounded-xl border border-gray-800 bg-gray-900/50 p-4 space-y-4" data-testid="monitor-summary" data-status={ data.Status }>
		<div class="flex flex-wrap items-center gap-3">
			<span class="text-sm font-medium text-gray-200">Aggregate</span>
			@StateBadge(data.Status)
			<span class="text-xs text-gray-500">modules={ fmt.Sprintf("%d", data.ModuleCount) } stale={ fmt.Sprintf("%d", data.StaleCount) } degraded_transitions={ fmt.Sprintf("%d", data.DegradedCount) } events={ fmt.Sprintf("%d", data.EventsPublish) }</span>
		</div>
		if len(data.Modules) > 0 {
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
				for _, m := range data.Modules {
					<div class="rounded-lg border border-gray-800 bg-gray-950/40 p-3">
						<div class="text-sm text-gray-200 truncate">{ m.ID }</div>
						<div class="flex items-center gap-2 mt-1">
							@StateBadge(m.State)
							if m.Stale {
								<span class="text-xs text-yellow-400">stale</span>
							}
						</div>
						if m.Error != "" {
							<div class="text-xs text-red-400 mt-1 truncate" title={ m.Error }>{ m.Error }</div>
						}
					</div>
				}
			</div>
		} else {
			<p class="text-sm text-gray-500">No modules have reported health yet.</p>
		}
		if len(data.Recent) > 0 {
			<div>
				<div class="text-xs font-medium text-gray-500 uppercase tracking-wider mb-2">Recent events</div>
				<ul class="space-y-1">
					for _, ev := range data.Recent {
						<li class="text-xs text-gray-400 truncate">
							<span class="text-gray-300">{ ev.Type }</span>
							if ev.ModuleID != "" {
								<span class="text-gray-500"> · { ev.ModuleID }</span>
							}
							if ev.Message != "" {
								<span class="text-gray-600"> — { ev.Message }</span>
							}
						</li>
					}
				</ul>
			</div>
		}
	</div>
}

templ LeaderCard(data DashboardData) {
	<div class="rounded-xl border border-gray-800 bg-gray-900/50 p-4">
		<div class="text-xs font-medium text-gray-500 uppercase tracking-wider mb-2">Leader</div>
		<div class="flex items-center gap-2 mb-1">
			<span class="w-2 h-2 rounded-full bg-yellow-400 shrink-0"></span>
			<div class="text-lg font-bold text-white truncate">{ displayNodeID(data.LeaderID) }</div>
		</div>
		if data.LeaderGRPCAddr != "" {
			<div class="text-xs text-gray-400">gRPC: { data.LeaderGRPCAddr }</div>
		}
		if data.LeaderHTTPAddr != "" {
			<div class="text-xs text-gray-400">HTTP: { data.LeaderHTTPAddr }</div>
		}
		<div class="text-xs text-gray-500 mt-1">Current cluster leader</div>
	</div>
}

templ ClusterStatCard(label string, value string, desc string) {
	<div class="rounded-xl border border-gray-800 bg-gray-900/50 p-4">
		<div class="text-xs font-medium text-gray-500 uppercase tracking-wider">{ label }</div>
		<div class="text-xl font-bold text-white mt-1 truncate">{ value }</div>
		<div class="text-xs text-gray-500 mt-1">{ desc }</div>
	</div>
}

templ HealthGrid(modules []ModuleHealthItem) {
	if len(modules) == 0 {
		<div class="rounded-xl border border-gray-800 bg-gray-900/50 p-4 text-sm text-gray-500">No modules registered.</div>
	} else {
		for _, m := range modules {
			@HealthCard(m)
		}
	}
}

type ModuleHealthItem struct {
	ID      string
	Name    string
	State   string
	Healthy bool
	Error   string
}

templ HealthCard(m ModuleHealthItem) {
	<div class="rounded-xl border border-gray-800 bg-gray-900/50 p-4">
		<div class="flex items-center justify-between mb-1">
			<div class="text-sm font-medium text-gray-200 truncate">{ m.Name }</div>
			@HealthDot(m.Healthy)
		</div>
		<div class="text-xs text-gray-500 mb-2 truncate">{ m.ID }</div>
		<div class="flex items-center gap-2">
			@StateBadge(m.State)
			if m.Error != "" {
				<span class="text-xs text-red-400 truncate" title={ m.Error }>{ m.Error }</span>
			}
		</div>
	</div>
}
