package templates

import "fmt"

type DashboardData struct {
	NodeCount         int
	LeaderID          string
	LeaderHTTPAddr    string
	LeaderGRPCAddr    string
	LeaderModuleCount int
	SessionCount      int
	LibraryCount      int
	QueueFailureCount int
	WantedQueueCount  int
	UpcomingCalendar  []UnifiedCalendarItem
	Disconnected      bool
}

func displayNodeID(id string) string {
	if len(id) >= 8 && id[:8] == "muxcore-" {
		id = id[8:]
	}
	if len(id) > 0 && id[0] == ':' {
		return "localhost" + id
	}
	return id
}

func nodeAvatar(id string) string {
	for _, ch := range id {
		if ch >= 'a' && ch <= 'z' {
			return string(ch - 32)
		}
		if ch >= 'A' && ch <= 'Z' {
			return string(ch)
		}
		if ch >= '0' && ch <= '9' {
			return string(ch)
		}
	}
	if len(id) > 0 {
		return id[:1]
	}
	return "N"
}

templ NoAuthPage() {
	<div class="flex min-h-full items-center justify-center">
		<div class="text-center max-w-md">
			<div class="mx-auto w-12 h-12 rounded-[var(--radius-lg)] bg-yellow-600/20 border border-yellow-700/50 flex items-center justify-center text-xl mb-4">!</div>
			<h1 class="text-2xl font-bold mb-2">No Auth Provider</h1>
			<p class="text-gray-400 text-sm mb-4">
				No <code class="text-gray-300 bg-gray-800 px-1 rounded">AuthProvider</code> module is registered with core.
				The admin UI requires an auth module to handle login.
			</p>
			<p class="text-gray-500 text-xs">
				Register an auth module with core, then restart the admin UI.
			</p>
		</div>
	</div>
}

templ DashboardPage(data DashboardData) {
	if data.Disconnected {
		<div class="flex min-h-full items-center justify-center">
			<div class="text-center max-w-md">
				<div class="mx-auto w-12 h-12 rounded-[var(--radius-lg)] bg-red-600/20 border border-red-700/50 flex items-center justify-center text-xl mb-4">!</div>
				<h1 class="text-2xl font-bold mb-2">Disconnected</h1>
				<p class="text-gray-400 text-sm">Could not connect to core at the configured gRPC address.</p>
			</div>
		</div>
	} else {
		<div class="space-y-6">
			<div>
				<h1 class="text-2xl font-bold">Dashboard</h1>
				<p class="text-gray-400 text-sm mt-1">Welcome back — here is what is running on your server.</p>
			</div>
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4">
				@ClusterStatCard("Nodes", fmt.Sprintf("%d", data.NodeCount), "Cluster members online")
				@LeaderCard(data)
				@ClusterStatCard("Sessions", fmt.Sprintf("%d", data.SessionCount), "Signed-in admin users")
				@ClusterStatCard("Libraries", fmt.Sprintf("%d", data.LibraryCount), "Media libraries")
				@ClusterStatCard("Version", "v0.1.0", "MuxCore version")
			</div>
			if data.QueueFailureCount > 0 {
				<div class="rounded-[var(--radius-lg)] border border-amber-800/60 bg-amber-950/20 p-4" data-testid="dashboard-queue-alert">
					<div class="flex flex-wrap items-center justify-between gap-3">
						<p class="text-sm text-amber-200">
							<span class="font-semibold">{ fmt.Sprintf("%d", data.QueueFailureCount) }</span>
							queue item(s) need attention — failed, stalled, or import errors.
						</p>
						<a href="/queue" class="text-sm font-medium text-amber-300 hover:underline">Review queue</a>
					</div>
				</div>
			}
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-4" data-testid="dashboard-daily-driver">
				<div class="rounded-[var(--radius-lg)] border border-gray-800 bg-gray-900/50 p-4 space-y-3">
					<div class="flex items-center justify-between gap-2">
						<h2 class="text-sm font-semibold text-gray-300">Download queue</h2>
						<a href="/queue" class="text-xs text-[var(--accent-color)] hover:underline">Open queue</a>
					</div>
					<div class="flex flex-wrap gap-4 text-sm">
						<div>
							<div class="text-2xl font-bold text-[var(--text-primary)]">{ fmt.Sprintf("%d", data.WantedQueueCount) }</div>
							<div class="text-xs text-gray-500">Wanted items</div>
						</div>
						<div>
							<div class="text-2xl font-bold text-amber-300">{ fmt.Sprintf("%d", data.QueueFailureCount) }</div>
							<div class="text-xs text-gray-500">Need attention</div>
						</div>
					</div>
				</div>
				<div class="rounded-[var(--radius-lg)] border border-gray-800 bg-gray-900/50 p-4 space-y-3">
					<div class="flex items-center justify-between gap-2">
						<h2 class="text-sm font-semibold text-gray-300">Upcoming releases</h2>
						<a href="/calendar" class="text-xs text-[var(--accent-color)] hover:underline">Full calendar</a>
					</div>
					if len(data.UpcomingCalendar) == 0 {
						<p class="text-sm text-gray-500">No upcoming airings in the next two weeks.</p>
					} else {
						<ul class="space-y-2">
							for _, it := range data.UpcomingCalendar {
								<li class="flex items-start justify-between gap-3 text-sm">
									<div class="min-w-0">
										<div class="truncate text-gray-200">{ it.Title }</div>
										<div class="text-xs text-gray-500 truncate">{ it.ModuleName } · { it.Kind }</div>
									</div>
									<span class="shrink-0 text-xs text-gray-400">{ it.Date }</span>
								</li>
							}
						</ul>
					}
				</div>
			</div>
			<div class="rounded-[var(--radius-lg)] border border-gray-800 bg-gray-900/50 p-4">
				<h2 class="text-sm font-semibold text-gray-300 mb-3">Common tasks</h2>
				<div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-2 text-sm">
					<a href="/users" class="rounded-lg border border-gray-800 bg-gray-950/40 px-3 py-2 text-[var(--accent-color)] hover:border-gray-700 hover:bg-gray-900/60">Manage users</a>
					<a href="/invites" class="rounded-lg border border-gray-800 bg-gray-950/40 px-3 py-2 text-[var(--accent-color)] hover:border-gray-700 hover:bg-gray-900/60">Invite someone</a>
					<a href="/libraries" class="rounded-lg border border-gray-800 bg-gray-950/40 px-3 py-2 text-[var(--accent-color)] hover:border-gray-700 hover:bg-gray-900/60">Libraries</a>
					<a href="/request" class="rounded-lg border border-gray-800 bg-gray-950/40 px-3 py-2 text-[var(--accent-color)] hover:border-gray-700 hover:bg-gray-900/60">Media requests</a>
					<a href="/backups" class="rounded-lg border border-gray-800 bg-gray-950/40 px-3 py-2 text-[var(--accent-color)] hover:border-gray-700 hover:bg-gray-900/60">Backups</a>
					<a href="/queue" class="rounded-lg border border-gray-800 bg-gray-950/40 px-3 py-2 text-[var(--accent-color)] hover:border-gray-700 hover:bg-gray-900/60">Download queue</a>
					<a href="/calendar" class="rounded-lg border border-gray-800 bg-gray-950/40 px-3 py-2 text-[var(--accent-color)] hover:border-gray-700 hover:bg-gray-900/60">Release calendar</a>
					<a href="/activity" class="rounded-lg border border-gray-800 bg-gray-950/40 px-3 py-2 text-[var(--accent-color)] hover:border-gray-700 hover:bg-gray-900/60">Recent activity</a>
					<a href="/branding" class="rounded-lg border border-gray-800 bg-gray-950/40 px-3 py-2 text-[var(--accent-color)] hover:border-gray-700 hover:bg-gray-900/60">Login branding</a>
					<a href="/streams" class="rounded-lg border border-gray-800 bg-gray-950/40 px-3 py-2 text-[var(--accent-color)] hover:border-gray-700 hover:bg-gray-900/60">Who is watching</a>
					<a href="/settings" class="rounded-lg border border-gray-800 bg-gray-950/40 px-3 py-2 text-gray-400 hover:border-gray-700 hover:bg-gray-900/60">Advanced settings</a>
				</div>
			</div>
			<div>
				<h2 class="text-lg font-semibold mb-3">Module Health</h2>
				<div
					id="health-grid"
					class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4"
					hx-get="/dashboard/health"
					hx-trigger="load, every 5s"
					hx-target="this"
					hx-swap="innerHTML"
				>
					@LoadingCard()
				</div>
			</div>
			<div>
				<h2 class="text-lg font-semibold mb-3">Health Monitor</h2>
				<div
					id="monitor-summary"
					hx-get="/dashboard/monitor"
					hx-trigger="load, every 10s"
					hx-target="this"
					hx-swap="innerHTML"
				>
					@LoadingCard()
				</div>
			</div>
		</div>
	}
}

type MonitorSummaryData struct {
	Status        string
	ModuleCount   int
	StaleCount    int64
	DegradedCount int64
	EventsPublish int64
	Modules       []MonitorModuleItem
	Recent        []MonitorEventItem
}

type MonitorModuleItem struct {
	ID    string
	State string
	Stale bool
	Error string
}

type MonitorEventItem struct {
	Type     string
	ModuleID string
	Message  string
}

templ MonitorSummary(data MonitorSummaryData) {
	<div class="rounded-[var(--radius-lg)] border border-gray-800 bg-gray-900/50 p-4 space-y-4" data-testid="monitor-summary" data-status={ data.Status }>
		<div class="flex flex-wrap items-center gap-3">
			<span class="text-sm font-medium text-gray-200">Aggregate</span>
			@StateBadge(data.Status)
			<span class="text-xs text-gray-500">modules={ fmt.Sprintf("%d", data.ModuleCount) } stale={ fmt.Sprintf("%d", data.StaleCount) } degraded_transitions={ fmt.Sprintf("%d", data.DegradedCount) } events={ fmt.Sprintf("%d", data.EventsPublish) }</span>
		</div>
		if len(data.Modules) > 0 {
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
				for _, m := range data.Modules {
					<div class="rounded-lg border border-gray-800 bg-gray-950/40 p-3">
						<div class="text-sm text-gray-200 truncate">{ m.ID }</div>
						<div class="flex items-center gap-2 mt-1">
							@StateBadge(m.State)
							if m.Stale {
								<span class="text-xs text-yellow-400">stale</span>
							}
						</div>
						if m.Error != "" {
							<div class="text-xs text-red-400 mt-1 truncate" title={ m.Error }>{ m.Error }</div>
						}
					</div>
				}
			</div>
		} else {
			<p class="text-sm text-gray-500" data-testid="monitor-empty-modules">No modules have reported health yet.</p>
		}
		if len(data.Recent) > 0 {
			<div>
				<div class="text-xs font-medium text-gray-500 uppercase tracking-wider mb-2">Recent events</div>
				<ul class="space-y-1">
					for _, ev := range data.Recent {
						<li class="text-xs text-gray-400 truncate">
							<span class="text-gray-300">{ ev.Type }</span>
							if ev.ModuleID != "" {
								<span class="text-gray-500">· { ev.ModuleID }</span>
							}
							if ev.Message != "" {
								<span class="text-gray-600">— { ev.Message }</span>
							}
						</li>
					}
				</ul>
			</div>
		}
	</div>
}

templ LeaderCard(data DashboardData) {
	<div class="rounded-[var(--radius-lg)] border border-gray-800 bg-gray-900/50 p-4 transition-colors hover:border-gray-700">
		<div class="text-xs font-medium text-gray-500 uppercase tracking-wider mb-2">Leader</div>
		<div class="flex items-center gap-2 mb-1">
			<span class="w-2 h-2 rounded-full bg-[var(--warning)] shrink-0"></span>
			<div class="text-lg font-bold text-[var(--text-primary)] truncate">{ displayNodeID(data.LeaderID) }</div>
		</div>
		if data.LeaderGRPCAddr != "" {
			<div class="text-xs text-gray-400">gRPC: { data.LeaderGRPCAddr }</div>
		}
		if data.LeaderHTTPAddr != "" {
			<div class="text-xs text-gray-400">HTTP: { data.LeaderHTTPAddr }</div>
		}
		<div class="text-xs text-gray-500 mt-1">Current cluster leader</div>
	</div>
}

templ ClusterStatCard(label string, value string, desc string) {
	<div class="rounded-[var(--radius-lg)] border border-gray-800 bg-gray-900/50 p-4 transition-colors hover:border-gray-700">
		<div class="text-xs font-medium text-gray-500 uppercase tracking-wider">{ label }</div>
		<div class="text-xl font-bold text-[var(--text-primary)] mt-1 truncate">{ value }</div>
		<div class="text-xs text-gray-500 mt-1">{ desc }</div>
	</div>
}

templ HealthGrid(modules []ModuleHealthItem) {
	if len(modules) == 0 {
		<div class="rounded-[var(--radius-lg)] border border-gray-800 bg-gray-900/50 p-4 text-sm text-gray-500">No modules registered.</div>
	} else {
		for _, m := range modules {
			@HealthCard(m)
		}
	}
}

type ModuleHealthItem struct {
	ID      string
	Name    string
	State   string
	Healthy bool
	Error   string
}

templ HealthCard(m ModuleHealthItem) {
	<div class="rounded-[var(--radius-lg)] border border-gray-800 bg-gray-900/50 p-4 transition-colors hover:border-gray-700">
		<div class="flex items-center justify-between mb-1">
			<div class="text-sm font-medium text-gray-200 truncate">{ m.Name }</div>
			@HealthDot(m.Healthy)
		</div>
		<div class="text-xs text-gray-500 mb-2 truncate">{ m.ID }</div>
		<div class="flex items-center gap-2">
			@StateBadge(m.State)
			if m.Error != "" {
				<span class="text-xs text-red-400 truncate" title={ m.Error }>{ m.Error }</span>
			}
		</div>
	</div>
}
