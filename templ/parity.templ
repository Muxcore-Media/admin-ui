package templates

templ ParitySectionPage(title, summary string, links []NavLink, notes []string) {
	<div class="space-y-6 max-w-4xl">
		<div>
			<h1 class="text-2xl font-bold">{ title }</h1>
			<p class="text-gray-400 text-sm mt-1">{ summary }</p>
		</div>

		if len(links) > 0 {
			<div class="rounded-xl border border-gray-800 bg-gray-900/50 p-4 space-y-2">
				<div class="text-xs font-medium text-gray-500 uppercase tracking-wider">Related MuxCore surfaces</div>
				<ul class="space-y-1">
					for _, l := range links {
						<li>
							<a href={ l.Path } class="text-sm text-indigo-400 hover:text-indigo-300">{ l.Label }</a>
						</li>
					}
				</ul>
			</div>
		}

		if len(notes) > 0 {
			<div class="rounded-xl border border-gray-800 bg-gray-900/50 divide-y divide-gray-800">
				for _, n := range notes {
					<div class="px-4 py-3 text-sm text-gray-300">{ n }</div>
				}
			</div>
		}
	</div>
}
